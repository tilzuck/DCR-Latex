# Layout variants of 08-holistic.xml: "name: options of \includedcrgraph"

# classic notation: pre-conditions become condition + milestone; the logical
# include G->E becomes include [A6 > 10] + exclude [not(A6 > 10)]
classic: notation=Classic

# CoopIS2023 notation (paper proposal, as in DCR-js): translated like Classic
coopis2023: notation=CoopIS2023
