# Layout variants of 03-relationships.xml: "name: options of \includedcrgraph"

# classic notation: the pre-condition A1->A2 becomes condition + milestone,
# the logical include A3->A4 becomes include + exclude (guard not(true))
classic: notation=classic

# CoopIS2023 notation (paper proposal, as in DCR-js): translated like Classic
coopis23: notation=coopis23
