\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dcrgraph}[2026/09/27 v0.2 DCR graphs with TikZ]

% Notation of the RELATIONS (activities, nestings etc. look the same):
%   \usepackage{dcrgraph}         DCR Solutions portal markers (default;
%                                 = option dcr-solutions)
%   \usepackage[classic]{dcrgraph}  traditional arrows from the literature
%                                 (->•, •->, ->+, ->%, ->◇)
%   \usepackage[coopis23]{dcrgraph}  the proposal of "Designing
%                                 Semantically Transparent Declarative
%                                 Process Constraints" (CoopIS 2023; as in
%                                 DCR-js): triangle at the source, circled
%                                 symbol at the target
% It can also be switched per document (\dcrset{notation=...}), per graph
% (\begin{dcrgraph}[notation=...]) or per inline symbol (notation=...).
% coopis23 is classic with other symbols: \ifdcr@classic is true for
% both (same relations, same translations, values as text).
\newif\ifdcr@classic
\newif\ifdcr@coopis
\DeclareOption{dcr-solutions}{\dcr@classicfalse\dcr@coopisfalse}
\DeclareOption{classic}{\dcr@classictrue\dcr@coopisfalse}
\DeclareOption{coopis23}{\dcr@classictrue\dcr@coopistrue}
\ProcessOptions\relax

\RequirePackage{tikz}
\RequirePackage{graphicx}                   % \scalebox (width= etc.)
\PassOptionsToPackage{breakall}{truncate}  % allow cutting inside words
\RequirePackage{truncate}                   % "DCRAgent.Crea..." subtitles
\usetikzlibrary{arrows.meta,positioning,calc,fit,shapes.geometric}

% ------------------------------------------------------------------
%  Colours and user-facing styles (override with \dcrset or \tikzset)
% ------------------------------------------------------------------
\definecolor{dcr condition}{HTML}{F5A030}
\definecolor{dcr response}{HTML}{1E88E5}
\definecolor{dcr border}{HTML}{CCCCCC}     % as in the DCR portal
\definecolor{dcr executed}{HTML}{00A837}
\definecolor{dcr activity}{HTML}{F9F7ED}  % cream fill, as in the DCR portal
\definecolor{dcr nesting}{HTML}{F9F7ED}
\colorlet{dcr text}{black}                  % label and role text
\definecolor{dcr include}{HTML}{10A33A}
\definecolor{dcr exclude}{HTML}{E8112D}
\definecolor{dcr milestone}{HTML}{C711EA}
\definecolor{dcr update}{HTML}{AFBFC2}
\definecolor{dcr noresponse}{HTML}{7B554A}
\definecolor{dcr subtitle}{HTML}{9A9A9A}
\definecolor{dcr delay}{HTML}{EBAA49}
\colorlet{dcr spawn}{black}                  % as in the DCR portal
% "|||" of subgraphs: black (the blue #3386BB and brown #A06860 measured on
% portal screenshots were ClearType's coloured fringes of thin black text)
\colorlet{dcr subgraph}{black}                    % subgraph event (empty)
\colorlet{dcr subgraph collection}{dcr subgraph}  % subgraph with events
\colorlet{dcr precondition}{dcr condition}
\colorlet{dcr logical include}{dcr include}
\colorlet{dcr icon}{black!45}                 % global, #, f, n, s, |||
\colorlet{dcr dmn}{dcr response}
\definecolor{dcr receiver}{HTML}{D3D3D3}  % receiver band (choreographies)

\newlength\dcr@header  \setlength\dcr@header{0.45cm}
% marker sizes as in the DCR portal: 16px at 115px box width (2.6cm)
\newlength\dcr@csize   \setlength\dcr@csize{10.3pt}  % condition dot diameter
\newlength\dcr@rsize   \setlength\dcr@rsize{10.3pt}  % response square side
\newlength\dcr@gap     \setlength\dcr@gap{0pt}
\newlength\dcr@border  \setlength\dcr@border{1.5pt}  % box line width
\newlength\dcr@datasize \setlength\dcr@datasize{0.36cm} % data page icon
\newlength\dcr@rx
\newlength\dcr@lw  \setlength\dcr@lw{2.3cm}    % label width (set per box)
\newsavebox\dcr@lbox                            % for measuring a label
\newlength\dcr@dmnsize \setlength\dcr@dmnsize{8pt}  % DMN table icon width
\newlength\dcr@rwidth  \setlength\dcr@rwidth{1.3pt}   % relation line width

% font used for everything inside a DCR graph (default: sans serif,
% like the DCR portal). Change with \dcrset{font=...}
\def\dcr@font{\sffamily}
\def\dcr@subfont{\footnotesize\itshape}

\tikzset{
  dcr/.is family,
  dcr/font/.code={\def\dcr@font{#1}},
  % default background of activities and of nestings/subprocesses, for a
  % whole graph or document; single activities can still use bgcolor=...
  dcr/bgcolor/.code={\colorlet{dcr activity}{#1}},
  dcr/nesting bgcolor/.code={\colorlet{dcr nesting}{#1}},
  dcr/header height/.code={\setlength\dcr@header{#1}},
  % the activity box
  dcr/activity/.style={
    draw=dcr border, line width=\dcr@border, rounded corners=4pt,
    fill=dcr activity, minimum width=2.6cm, minimum height=2.8cm,
    inner sep=0pt, outer sep=0pt},
  % (outer sep=0pt, also for collections: the border TikZ uses for anchors
  % and lines is then exactly the drawn outline, and every marker is placed
  % from it the same way -- half the line width + half the marker -- so
  % all markers touch the outline alike, self-relation markers included)
  dcr/role/.style={font=\dcr@font\bfseries\small},
  dcr/receiver/.style={dcr/role},
  % with a receiver: the box is one header taller (the band at the
  % bottom), as in the DCR portal; an explicit minimum height still wins
  dcr/receiver band/.code={%
    \pgfmathsetlength\dimen@ii{\pgfkeysvalueof{/pgf/minimum height}}%
    \advance\dimen@ii by \dcr@header
    \pgfkeyssetevalue{/pgf/minimum height}{\the\dimen@ii}},
  % the label: as wide as the box (minus 0.3cm), see dcr/fit label
  dcr/label/.style={font=\dcr@font\small, text width=\dcr@lw, align=flush center,
    execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  % Applied last to an activity's box: the label's width follows the box
  % width, and the box grows taller (evenly, it is centred) if the label
  % needs more room than the box offers -- long labels never run out.
  dcr/fit label/.code={%
    \pgfmathsetlength\dimen@ii{\pgfkeysvalueof{/pgf/minimum width}}%
    \global\dcr@lw=\dimen@ii
    \global\advance\dcr@lw by -0.3cm
    % (measured outside the picture: in it, fonts are \nullfont)
    \pgfinterruptpicture
      \global\setbox\dcr@lbox\hbox{\parbox{\dcr@lw}{\centering\dcr@font\small
        \hyphenpenalty=10000\exhyphenpenalty=10000 \dcr@labeltext}}%
    \endpgfinterruptpicture
    \dimen@=\ht\dcr@lbox \advance\dimen@ by \dp\dcr@lbox
    \ifx\dcr@subtitle\@empty\else\advance\dimen@ by 13pt\fi
    \ifx\dcr@receiver\@empty\else\advance\dimen@ by \dcr@header\fi
    \advance\dimen@ by \dcr@header \advance\dimen@ by 0.7cm  % + margins, inner sep
    \pgfmathsetlength\dimen@ii{\pgfkeysvalueof{/pgf/minimum height}}%
    \ifdim\dimen@>\dimen@ii
      \pgfkeyssetevalue{/pgf/minimum height}{\the\dimen@}%
    \fi},
  dcr/excluded/.style={dashed},
  % nestings
  dcr/nesting/.style={draw=dcr border, line width=\dcr@border,
    rounded corners=4pt, fill=dcr nesting, inner sep=0.45cm, outer sep=0pt},
  dcr/nesting label/.style={font=\dcr@font\small},
  dcr/nesting marker/.style={font=\dcr@font\bfseries\small, text=black!45},
  dcr/pending marker/.style={text=dcr response, font=\dcr@font\bfseries\large},
  dcr/executed marker/.style={text=dcr executed, font=\bfseries},
  % the relations
  dcr/relation/.style={line width=\dcr@rwidth},
  dcr/relation width/.code={\setlength\dcr@rwidth{#1}},
  dcr/border width/.code={\setlength\dcr@border{#1}},
  dcr/condition/.style={dcr/relation, color=dcr condition},
  dcr/response/.style={dcr/relation, color=dcr response},
  % end markers: their size is set with the keys below, not here
  % condition: open orange circle; its outer diameter is the marker size
  dcr/condition marker/.style={circle, fill=white, draw=dcr condition,
    line width=0.15\dcr@csize, inner sep=0pt, minimum size=0.85\dcr@csize},
  % square markers: same box for all; the white symbol is drawn as
  % shapes (not font glyphs), so "!", "+" and "-" match exactly
  dcr/square marker/.style={rectangle, draw=none, inner sep=0pt,
    minimum width=\dcr@rsize, minimum height=\dcr@rsize, rounded corners=1pt},
  dcr/response marker/.style={dcr/square marker, fill=dcr response,
    path picture={%
      \dcr@glyph{-0.08}{-0.02}{0.08}{0.32}%   bar of the "!"
      \dcr@glyph{-0.08}{-0.32}{0.08}{-0.16}}}, % dot of the "!"
  dcr/include marker/.style={dcr/square marker, fill=dcr include,
    path picture={%
      \dcr@glyph{-0.30}{-0.08}{0.30}{0.08}%
      \dcr@glyph{-0.08}{-0.30}{0.08}{0.30}}},
  dcr/exclude marker/.style={dcr/square marker, fill=dcr exclude,
    path picture={\dcr@glyph{-0.30}{-0.08}{0.30}{0.08}}},
  dcr/milestone marker/.style={circle, fill=dcr milestone, draw=none,
    inner sep=0pt, minimum size=\dcr@csize,
    path picture={%
      \dcr@glyph{-0.08}{-0.02}{0.08}{0.32}%
      \dcr@glyph{-0.08}{-0.32}{0.08}{-0.16}}},
  dcr/update marker/.style={dcr/square marker, fill=dcr update,
    path picture={%
      \dcr@glyph{-0.28}{0.06}{0.28}{0.20}%
      \dcr@glyph{-0.28}{-0.20}{0.28}{-0.06}}},
  dcr/noresponse marker/.style={dcr/square marker, fill=dcr noresponse,
    path picture={%
      \draw[white, line width=0.16\dcr@rsize, line cap=butt]
        ([shift={(-0.22\dcr@rsize,-0.22\dcr@rsize)}]path picture bounding box.center) --
        ([shift={(0.22\dcr@rsize,0.22\dcr@rsize)}]path picture bounding box.center)
        ([shift={(-0.22\dcr@rsize,0.22\dcr@rsize)}]path picture bounding box.center) --
        ([shift={(0.22\dcr@rsize,-0.22\dcr@rsize)}]path picture bounding box.center);}},
  dcr/noresponse/.style={dcr/relation, color=dcr noresponse},
  % pre-condition: filled orange dot
  dcr/precondition/.style={dcr/relation, color=dcr precondition},
  dcr/precondition marker/.style={circle, fill=dcr precondition, draw=none,
    inner sep=0pt, minimum size=\dcr@csize},
  % spawn: square with a white asterisk (three crossing bars)
  dcr/spawn/.style={dcr/relation, color=dcr spawn},
  dcr/spawn marker/.style={dcr/square marker, fill=dcr spawn,
    path picture={%
      \foreach \dcr@a in {90,30,-30}{%
        \draw[white, line width=0.14\dcr@rsize, line cap=butt]
          ([shift={(\dcr@a:0.32\dcr@rsize)}]path picture bounding box.center) --
          ([shift={(\dcr@a+180:0.32\dcr@rsize)}]path picture bounding box.center);}}},
  % logical include: "+" with a bar below it ("±"), as in the DCR portal
  dcr/logical include/.style={dcr/relation, color=dcr logical include},
  dcr/logical include marker/.style={dcr/square marker, fill=dcr logical include,
    path picture={%
      \dcr@glyph{-0.26}{0.07}{0.26}{0.19}%     + horizontal
      \dcr@glyph{-0.06}{-0.13}{0.06}{0.39}%    + vertical
      \dcr@glyph{-0.30}{-0.36}{0.30}{-0.24}}},% bar
  % event and collection icons
  dcr/access marker/.style={text=dcr icon, font=\dcr@font\small, inner sep=1pt},
  dcr/dmn size/.code={\setlength\dcr@dmnsize{#1}},
  dcr/dmn grid/.style={draw=dcr dmn, line width=0.6pt},
  dcr/global icon/.style={draw=dcr icon, line width=0.6pt, fill=white},
  dcr/form marker/.style={dcr/nesting marker},
  % subgraph (template) event: fine dotted outline, blue "|||"
  dcr/subgraph/.style={dash pattern=on 0pt off 3pt, line cap=round},
  dcr/subgraph bars/.style={draw=dcr subgraph, line width=0.9pt},
  dcr/subgraph collection bars/.style={draw=dcr subgraph collection, line width=0.9pt},
  dcr/milestone/.style={dcr/relation, color=dcr milestone},
  dcr/update/.style={dcr/relation, color=dcr update},
  dcr/subtitle font/.code={\def\dcr@subfont{#1}},
  dcr/include/.style={dcr/relation, color=dcr include},
  dcr/exclude/.style={dcr/relation, color=dcr exclude},
  dcr/marker symbol/.style={fill=white, sharp corners},
  % activity decorations
  dcr/data size/.code={\setlength\dcr@datasize{#1}},
  dcr/data icon/.style={draw=dcr border, line width=0.6\dcr@border},
  dcr/computation marker/.style={text=dcr response, font=\dcr@font\bfseries\small},
  % one size for all end markers (dot diameter = square side)
  dcr/marker size/.code={\setlength\dcr@csize{#1}\setlength\dcr@rsize{#1}},
  dcr/condition marker size/.code={\setlength\dcr@csize{#1}},
  dcr/response marker size/.code={\setlength\dcr@rsize{#1}},
  % distance between a marker and the box outline (0pt = touching)
  dcr/marker gap/.code={\setlength\dcr@gap{#1}},
}

% Settings need no prefix: \dcrset{notation=classic} and
% \begin{dcrgraph}[notation=classic, scale=0.8]. Each key of the list is
% looked up among the dcr settings (also with a handler, e.g.
% `guard label/.append style={...}'); a key found there gets the prefix
% dcr/, every other key (TikZ options, own styles, dcr/... written out)
% is passed on unchanged. Result in \dcr@opts.
\ExplSyntaxOn
\tl_new:N \l__dcr_opts_tl
\tl_new:N \l__dcr_prefix_tl
\tl_new:N \l__dcr_base_tl
\cs_new:Npn \__dcr_base:w #1 /. #2 \q_stop {#1}
\cs_new_protected:Npn \__dcr_prefix:n #1
  {
    \tl_set:Nn \l__dcr_base_tl {#1}
    \tl_if_in:nnT {#1} { /. }
      { \tl_set:Nx \l__dcr_base_tl { \__dcr_base:w #1 \q_stop } }
    \tl_clear:N \l__dcr_prefix_tl
    \cs_if_exist:cT { pgfk@/tikz/dcr/ \l__dcr_base_tl /.@cmd }
      { \tl_set:Nn \l__dcr_prefix_tl { dcr/ } }
  }
\cs_new_protected:Npn \__dcr_opt_key:n #1
  {
    \__dcr_prefix:n {#1}
    \tl_put_right:Nx \l__dcr_opts_tl
      { \l__dcr_prefix_tl \exp_not:n {#1} , }
  }
\cs_new_protected:Npn \__dcr_opt_kv:nn #1#2
  {
    \__dcr_prefix:n {#1}
    \tl_put_right:Nx \l__dcr_opts_tl
      { \l__dcr_prefix_tl \exp_not:n {#1} = { \exp_not:n {#2} } , }
  }
\cs_new_protected:Npn \dcr@mapopts #1
  {
    \tl_clear:N \l__dcr_opts_tl
    \keyval_parse:NNn \__dcr_opt_key:n \__dcr_opt_kv:nn {#1}
    \cs_set_eq:NN \dcr@opts \l__dcr_opts_tl
  }
\ExplSyntaxOff
\newcommand\dcrset[1]{\dcr@mapopts{#1}\expandafter\tikzset\expandafter{\dcr@opts}}

\tikzset{
  dcr/notation/.is choice,
  dcr/notation/dcr-solutions/.code={\dcr@classicfalse\dcr@coopisfalse},
  dcr/notation/classic/.code={\dcr@classictrue\dcr@coopisfalse},
  dcr/notation/coopis23/.code={\dcr@classictrue\dcr@coopistrue},
  % arrows and symbols in the classic notation
  dcr/classic arrow/.style={},   % extra style for classic arrows (e.g. thinner lines)
}

% the executed tick, drawn as a path; #1 = its lower left corner
% (on the baseline). Size: dcr/tick size (default 7pt).
\newlength\dcr@ticksize \setlength\dcr@ticksize{7pt}
\tikzset{
  dcr/executed tick/.style={draw=dcr executed, line width=0.2\dcr@ticksize,
    line cap=round, line join=round},
  dcr/tick size/.code={\setlength\dcr@ticksize{#1}}}
\newcommand\dcr@tick[2][0pt]{% #1 extra x offset, #2 lower left corner
  \draw[dcr/executed tick]
    ([shift={(#1+0.08\dcr@ticksize,0.45\dcr@ticksize)}]#2) --
    ([shift={(#1+0.38\dcr@ticksize,0.1\dcr@ticksize)}]#2) --
    ([shift={(#1+\dcr@ticksize,0.95\dcr@ticksize)}]#2);}

% clock hands (12 and 4 o'clock) in colour #1 inside a marker of size #2
\newcommand\dcr@clockhands[2]{%
  \draw[#1, line width=0.09#2, line cap=round]
    ([yshift=0.2#2]path picture bounding box.center) --
    (path picture bounding box.center) --
    ([xshift=0.13#2,yshift=-0.11#2]path picture bounding box.center);}

% white rectangle inside a square marker; #1..#4 = x1,y1,x2,y2 as
% fractions of the marker size, measured from its centre
\newcommand\dcr@glyph[4]{%
  \fill[dcr/marker symbol]
    ([shift={(#1\dcr@rsize,#2\dcr@rsize)}]path picture bounding box.center)
    rectangle
    ([shift={(#3\dcr@rsize,#4\dcr@rsize)}]path picture bounding box.center);}

% The marking of box #1, top left, #2 below its top edge (the header):
% "!" (pending), then the tick (executed), standing on the baseline of the
% "!". As in the DCR portal, the tick always has the same place, also
% without "!" (an invisible "!" keeps the geometry the same).
\newcommand\dcr@marking[2]{%
  \ifdcr@pending\dcr@markingnode{#1}{#2}{!}%
  \else\ifdcr@executed\dcr@markingnode{#1}{#2}{\phantom{!}}\fi\fi}
\newcommand\dcr@markingnode[3]{%
  \node[dcr/pending marker, inner xsep=0pt, anchor=north west]
    (#1@pending) at ([xshift=7pt,yshift=-#2-1pt]#1.north west) {#3};
  \ifdcr@executed \dcr@tick[2.5pt]{#1@pending.base east}\fi}

% ------------------------------------------------------------------
%  Option parsing for \activity: DCR keys are handled here, every
%  other key (at=, right=of, xshift=, ...) is forwarded to the node.
% ------------------------------------------------------------------
\newif\ifdcr@pending
\newif\ifdcr@executed
\newif\ifdcr@excluded
\newif\ifdcr@data
\newif\ifdcr@computation
\newif\ifdcr@global
\newif\ifdcr@dmn
\newif\ifdcr@access
\newif\ifdcr@form
\newif\ifdcr@subgraph
% all flags off (start of \activity and of nestings)
\def\dcr@resetflags{\dcr@pendingfalse\dcr@executedfalse\dcr@excludedfalse
  \dcr@datafalse\dcr@computationfalse\dcr@globalfalse\dcr@dmnfalse
  \dcr@accessfalse\dcr@formfalse\dcr@subgraphfalse}

% for the .unknown handlers: the current key, with its value #2 (if
% any), appended to the option list in macro #1 (passed on to TikZ)
\newcommand\dcr@passon[2]{%
  \def\dcr@val{#2}%
  \ifx\dcr@val\pgfkeysnovalue@text
    \edef#1{\unexpanded\expandafter{#1}\pgfkeyscurrentname,}%
  \else
    \edef#1{\unexpanded\expandafter{#1}\pgfkeyscurrentname={\unexpanded{#2}},}%
  \fi}

\pgfkeys{
  /dcr@act/.is family, /dcr@act,
  role/.store in=\dcr@role,
  receiver/.store in=\dcr@receiver,   % choreographies: band at the bottom
  subtitle/.store in=\dcr@subtitle,
  bgcolor/.store in=\dcr@bg,          % background colour, any xcolor colour
  bordercolor/.store in=\dcr@bc,      % outline and header line
  textcolor/.store in=\dcr@tc,        % label and role
  pending/.code=\dcr@pendingtrue,
  executed/.code=\dcr@executedtrue,
  data/.code=\dcr@datatrue,
  computation/.code=\dcr@computationtrue,
  global/.code=\dcr@globaltrue,       % global event: icon bottom left
  dmn/.code=\dcr@dmntrue,             % DMN event: decision table icon
  access/.code=\dcr@accesstrue,       % access control: "#"
  form/.code=\dcr@formtrue,           % event with a form: "f" bottom right
  subgraph/.code=\dcr@subgraphtrue,   % subgraph (template) event, target
                                      % of spawns: dotted, "|||" and "g"
  area/.store in=\dcr@area,           % nestings: exact box {(x1,y1)(x2,y2)}
  excluded/.code=\dcr@excludedtrue,
  included/.code=\dcr@excludedfalse,
  .unknown/.code={\dcr@passon\dcr@tikzopts{#1}},
}

% ------------------------------------------------------------------
%  Commands (only defined inside the dcrgraph environment, so they
%  cannot clash with other packages)
% ------------------------------------------------------------------

% \activity[options]{label}{id}
\newcommand\dcr@activity[3][]{%
  \begingroup
    \def\dcr@role{}\def\dcr@receiver{}\def\dcr@subtitle{}\def\dcr@bg{}%
    \def\dcr@tikzopts{}\def\dcr@bc{dcr border}\def\dcr@tc{dcr text}%
    \dcr@resetflags
    \pgfkeys{/dcr@act,#1}%
    \def\dcr@labeltext{#2}%
    \edef\dcr@do{\noexpand\node[dcr/activity, draw=\dcr@bc,
      \ifx\dcr@bg\@empty\else fill=\dcr@bg,\fi
      \ifdcr@excluded dcr/excluded,\fi
      \ifdcr@subgraph dcr/subgraph,\fi
      \ifx\dcr@receiver\@empty\else dcr/receiver band,\fi
      \unexpanded\expandafter{\dcr@tikzopts}, dcr/fit label] (#3)}%
    \dcr@do {};
    % the rest relative to the box, which does not scale: on the canvas
    % (else scale= would move the header line, icons etc.)
    \pgftransformreset
    % receiver (choreographies): a grey band at the bottom, as high as the
    % header, with the receiver roles. Filled inside the outline only (the
    % clip is the inner edge of the border line), then the line above it.
    % \dcr@band: height of the band, the bottom icons sit above it.
    \ifx\dcr@receiver\@empty
      \def\dcr@band{0pt}%
    \else
      \def\dcr@band{\dcr@header}%
      \begin{scope}
        \clip[rounded corners=4pt-0.5\dcr@border]
          ([shift={(0.5\dcr@border,0.5\dcr@border)}]#3.south west) rectangle
          ([shift={(-0.5\dcr@border,-0.5\dcr@border)}]#3.north east);
        \fill[dcr receiver] (#3.south west) rectangle
          ([yshift=\dcr@header]#3.south east);
      \end{scope}
      \draw[draw=\dcr@bc, line width=\dcr@border,
            \ifdcr@excluded dcr/excluded\fi]
        ([yshift=\dcr@header]#3.south west) --
        ([yshift=\dcr@header]#3.south east);
      \node[dcr/receiver, text=\dcr@tc] at ([yshift=0.5\dcr@header]#3.south)
        {\dcr@receiver};
    \fi
    % header: always drawn, as in the DCR portal; role text if given.
    % A subgraph (template) has no header; its label is centred in the box.
    \ifdcr@subgraph
      \def\dcr@ly{0pt}%
    \else
      \def\dcr@ly{-0.5\dcr@header}%
      \draw[draw=\dcr@bc, line width=\dcr@border,
            \ifdcr@excluded dcr/excluded\fi]
        ([yshift=-\dcr@header]#3.north west) --
        ([yshift=-\dcr@header]#3.north east);
      \ifx\dcr@role\@empty\else
        \node[dcr/role, text=\dcr@tc] at ([yshift=-0.5\dcr@header]#3.north) {\dcr@role};
      \fi
    \fi
    \ifx\dcr@receiver\@empty\else\edef\dcr@ly{\dcr@ly+0.5\noexpand\dcr@header}\fi
    % label, centred in the body between the header and the receiver band
    \ifx\dcr@subtitle\@empty
      \node[dcr/label, text=\dcr@tc] at ([yshift=\dcr@ly]#3.center) {#2};
    \else  % label, and below it a grey subtitle cut off with "..."
      \node[dcr/label, text=\dcr@tc] at ([yshift=\dcr@ly]#3.center)
        {#2\\[3pt]{\dcr@font\dcr@subfont\color{dcr subtitle}%
          \truncate{\dimexpr\dcr@lw-0.1cm\relax}{\dcr@subtitle}}};
    \fi
    \dcr@marking{#3}{\dcr@header}%
    % right-hand icons, placed right to left: data page, DMN table, =, #
    \setlength\dcr@rx{3pt}%
    \ifdcr@data   % a "page" tucked into the corner under the header
      \draw[dcr/data icon, \ifdcr@excluded dcr/excluded\fi]
        ([xshift=-\dcr@datasize,yshift=-\dcr@header]#3.north east) --
        ([xshift=-\dcr@datasize,yshift=-\dcr@header-\dcr@datasize]#3.north east) --
        ([yshift=-\dcr@header-\dcr@datasize]#3.north east);
      \addtolength\dcr@rx{\dcr@datasize}%
    \fi
    \ifdcr@dmn    % DMN = a computation by decision table: a blue table
                  % grid where the "=" of a computation would be
      \begin{scope}[shift={([xshift=-\dcr@rx-0.5\dcr@dmnsize,
                            yshift=-\dcr@header-3pt-0.4\dcr@dmnsize]#3.north east)},
                    x=0.5\dcr@dmnsize, y=0.4\dcr@dmnsize]
        \draw[dcr/dmn grid] (-1,-1) rectangle (1,1) (-1,0.33) -- (1,0.33)
          (-1,-0.33) -- (1,-0.33) (-0.25,-1) -- (-0.25,1);
      \end{scope}
      \addtolength\dcr@rx{\dcr@dmnsize}\addtolength\dcr@rx{3pt}%
    \fi
    \ifdcr@computation
      \node[dcr/computation marker, anchor=north east, inner sep=1pt]
        at ([xshift=-\dcr@rx,yshift=-\dcr@header-1pt]#3.north east) {=};
      \addtolength\dcr@rx{8pt}%
    \fi
    \ifdcr@access
      \node[dcr/access marker, anchor=north east]
        at ([xshift=-\dcr@rx,yshift=-\dcr@header-1pt]#3.north east) {\#};
      \addtolength\dcr@rx{8pt}%
    \fi
    % bottom corners: global event (two overlapping pages), form ("f")
    \ifdcr@global
      \begin{scope}[shift={([xshift=6pt,yshift=6pt+\dcr@band]#3.south west)}]
        \draw[dcr/global icon] (-2.5pt,-1pt) rectangle (1pt,2.5pt);
        \draw[dcr/global icon] (-1pt,-2.5pt) rectangle (2.5pt,1pt);
      \end{scope}
    \fi
    \ifdcr@form
      \node[dcr/form marker, anchor=south east]
        at ([xshift=-3pt,yshift=1pt+\dcr@band]#3.south east) {f};
    \fi
    % subgraph: blue "|||" at the bottom centre, grey "g" bottom right
    \ifdcr@subgraph
      \draw[dcr/subgraph bars] \foreach \dcr@x in {-2.5pt,0pt,2.5pt}
        {([xshift=\dcr@x,yshift=4pt+\dcr@band]#3.south) -- ++(0,7pt)};
      \node[dcr/nesting marker, anchor=south east]
        at ([xshift=-3pt,yshift=1pt+\dcr@band]#3.south east) {g};
    \fi
  \endgroup
}

% ------------------------------------------------------------------
%  Relations
%
%  Every relation ends in a marker (dot, "!", ...) that must sit flush
%  against the outside of the target box, whatever the angle of the edge.
%  Procedure:
%    1. trace the edge invisibly to find where it hits the target border
%       (dcr@b) and which way it points there (dcr@a, a bit earlier);
%    2. find which side of the box was hit, and move the marker back
%       along the edge until its half-size fits between it and that side;
%    3. draw the edge up to the marker's centre, then draw the marker.
% ------------------------------------------------------------------
\newdimen\dcr@ax \newdimen\dcr@ay \newdimen\dcr@bx \newdimen\dcr@by
\newdimen\dcr@cx \newdimen\dcr@cy \newdimen\dcr@nx \newdimen\dcr@ny
\newdimen\dcr@t

% "node.anchor" -> "node"
\def\dcr@split#1.#2\@nil{\def\dcr@node{#1}}

% #1 = target (node or node.anchor), #2 = half size of the marker
% result: \dcr@t (distance marker centre -> border point along the edge)
%         \dcr@px, \dcr@py (marker centre)
\newcommand\dcr@computeend[2]{%
  \dcr@split#1.\@nil
  \pgfpointanchor{dcr@b}{center}\dcr@bx=\pgf@x \dcr@by=\pgf@y
  \pgfpointanchor{dcr@a}{center}\dcr@ax=\pgf@x \dcr@ay=\pgf@y
  \pgfpointanchor{\dcr@node}{center}\dcr@cx=\pgf@x \dcr@cy=\pgf@y
  \pgfpointanchor{\dcr@node}{north east}\dcr@nx=\pgf@x \dcr@ny=\pgf@y
  % unit vector pointing from the border back along the edge
  \pgfmathsetmacro\dcr@ux{\dcr@ax-\dcr@bx}%
  \pgfmathsetmacro\dcr@uy{\dcr@ay-\dcr@by}%
  \pgfmathsetmacro\dcr@l{max(veclen(\dcr@ux,\dcr@uy),0.001)}%
  \pgfmathsetmacro\dcr@ux{\dcr@ux/\dcr@l}%
  \pgfmathsetmacro\dcr@uy{\dcr@uy/\dcr@l}%
  % which side was hit? compare the relative position of the border
  % point horizontally and vertically (1 = on that side)
  \pgfmathsetmacro\dcr@sx{abs(\dcr@bx-\dcr@cx)/max(\dcr@nx-\dcr@cx,0.01)}%
  \pgfmathsetmacro\dcr@sy{abs(\dcr@by-\dcr@cy)/max(\dcr@ny-\dcr@cy,0.01)}%
  % component of the edge direction perpendicular to that side
  \pgfmathsetmacro\dcr@perp{\dcr@sx>\dcr@sy ? abs(\dcr@ux) : abs(\dcr@uy)}%
  % distance needed so the marker clears the side (+ half box line + gap);
  % capped for edges that graze the box almost parallel to a side
  \pgfmathsetmacro\dcr@h{#2+0.5*\dcr@border+\dcr@gap}%
  \pgfmathsetmacro\dcr@tt{min(\dcr@h/max(\dcr@perp,0.2), 4*\dcr@h)}%
  \dcr@t=\dcr@tt pt\relax
  \pgfmathsetmacro\dcr@px{\dcr@bx+\dcr@tt*\dcr@ux}%
  \pgfmathsetmacro\dcr@py{\dcr@by+\dcr@tt*\dcr@uy}%
}

% #1 line style, #2 marker style, #3 marker half size, #4 user options,
% #5 from, #6 to
% Relation options: DCR keys are handled here, everything else goes to
% TikZ (bend left, out=..., etc.).
%   delay=PT10S   delay of a condition (also a pre-condition)
%   deadline=P5D  deadline of a response
%                 Other relations have no time. Shown as a clock marker
%                 (+ the duration as text, see delays= / deadlines=)
%   guard         shield icon next to the marker (relation has a guard)
%   guard=expr    a guard with its expression (shown as shield or as text
%                 [ expr ] on the line, see guards= below)
%   guard side=right   write the guard text on the right of the line
%                 (seen from `from' to `to'); default left
%   explicit={guard,delay,deadline}   show these values of this relation as
%                 text, whatever the settings for the graph say (delay: the
%                 time of a condition etc., deadline: the time of a
%                 response); plain `explicit' = all three
%   corner=north west   self-relation in Classic: the corner of the loop
%                 (north east, north west, south east, south west);
%                 default: the next free corner
%   via={(x1,y1),(x2,y2),...}   route the line through these points
%   bundle=<node>:<name>   spread this relation with the others of the same
%                 bundle, as if they were parallel (for relations with a
%                 common end <node> that would lie on top of each other,
%                 e.g. to a nesting and to a nesting inside it)
\newif\ifdcr@guard
\newif\ifdcr@routed
\newif\ifdcr@xguard \newif\ifdcr@xdelay \newif\ifdcr@xdeadline
\pgfkeys{
  /dcr@expl/.is family, /dcr@expl,
  guard/.code=\dcr@xguardtrue,
  delay/.code=\dcr@xdelaytrue,
  deadline/.code=\dcr@xdeadlinetrue,
  .unknown/.code={\PackageError{dcrgraph}{explicit=\pgfkeyscurrentname:
    use guard, delay or deadline}{}},
}
\pgfkeys{
  /dcr@rel/.is family, /dcr@rel,
  delay/.store in=\dcr@delay,
  deadline/.store in=\dcr@deadline,
  via/.store in=\dcr@via,
  guard/.code={\dcr@guardtrue\def\dcr@gexpr{#1}},
  guard/.default={},
  explicit/.code={\pgfkeys{/dcr@expl,#1}},
  explicit/.default={guard,delay,deadline},
  bundle/.store in=\dcr@bundle,
  selfpos/.store in=\dcr@selfpos,
  corner/.store in=\dcr@corner,
  % the side of the line (seen from `from' to `to') where the guard is
  % written as text; default left
  guard side/.is choice,
  guard side/left/.code={\def\dcr@gside{left}},
  guard side/right/.code={\def\dcr@gside{right}},
  % internal, for the classic translation of a pre-condition: the milestone
  % has no time and no guard (both are written at the condition), and the
  % two lines of a route run side by side (dcr@shift: the route moved
  % sideways, to the left seen from `from')
  dcr@nodelay/.code={\def\dcr@delay{}},
  dcr@noguard/.code={\dcr@guardfalse\def\dcr@gexpr{}},
  dcr@shift/.store in=\dcr@rshift,
  .unknown/.code={\dcr@passon\dcr@ropts{#1}},
}

\def\dcr@kw@condition{dcr/condition}\def\dcr@kw@response{dcr/response}
\def\dcr@kw@precondition{dcr/precondition}
\newcommand\dcr@relation[6]{%
  \begingroup
  \def\dcr@from{#5}\def\dcr@to{#6}%
  \def\dcr@ropts{}\def\dcr@delay{}\def\dcr@deadline{}\def\dcr@via{}%
  \dcr@guardfalse\def\dcr@gexpr{}\def\dcr@off{0}%
  \dcr@xguardfalse\dcr@xdelayfalse\dcr@xdeadlinefalse\def\dcr@bundle{}%
  \def\dcr@selfpos{}\def\dcr@corner{}\def\dcr@gside{left}\def\dcr@rshift{0pt}%
  \pgfkeys{/dcr@rel,#4}%
  \ifx\dcr@via\@empty\dcr@routedfalse\else\dcr@routedtrue\fi
  % The points of a route are in the coordinates of the picture (scale=
  % etc. apply); everything else is drawn relative to the boxes, which do
  % not scale, from points computed on the canvas: no transformation from
  % here on (else scale= would move the markers off the lines)
  \ifdcr@routed
    \dcr@nv=0 \expandafter\dcr@vp@next\dcr@via\dcr@vp@end
  \fi
  \pgftransformreset
  % The time: a condition (also the condition in a pre-condition) has a
  % delay, a response a deadline, other relations none. From here on, the
  % time of either kind is \dcr@delay.
  \def\dcr@tmp{#1}%
  \ifx\dcr@tmp\dcr@kw@response
    \ifx\dcr@delay\@empty\else
      \PackageError{dcrgraph}{delay=\dcr@delay: a response has a deadline,
        not a delay}{Write deadline=\dcr@delay. The time is left out.}%
    \fi
    \let\dcr@delay\dcr@deadline
  \else
    \ifx\dcr@deadline\@empty\else
      \PackageError{dcrgraph}{deadline=\dcr@deadline: only a response has a
        deadline}{A condition has a delay (delay=), other relations have no
        time. The deadline is left out.}%
    \fi
    \ifx\dcr@delay\@empty\else
      \ifx\dcr@tmp\dcr@kw@condition\else\ifx\dcr@tmp\dcr@kw@precondition\else
        \PackageError{dcrgraph}{delay=\dcr@delay: only a condition (or a
          pre-condition) has a delay}{A response has a deadline
          (deadline=), other relations have no time. The delay is left
          out.}%
        \def\dcr@delay{}%
      \fi\fi
    \fi
  \fi
  % How this relation's guard and time (a deadline for responses, a delay
  % for conditions) are shown, from the settings of the graph (see
  % guards=, delays=, deadlines= below) and the key explicit={...}:
  %   portal:  guard = shield, time = clock marker; explicit adds the text
  %   classic: no shields, no clocks -- the values as text
  %   none:    nothing, in both notations
  % guard
  \dcr@gtextfalse\dcr@gshieldfalse\dcr@gallowshieldfalse
  \ifx\dcr@gmode\dcr@kw@none\else
    \ifdcr@classic
      \dcr@gtexttrue
    \else
      \dcr@gallowshieldtrue
      \ifx\dcr@gmode\dcr@kw@explicit\dcr@gtexttrue
      \else\ifx\dcr@gmode\dcr@kw@both\dcr@gtexttrue\dcr@gshieldtrue
      \else\dcr@gshieldtrue\fi\fi
    \fi
  \fi
  \ifdcr@xguard\dcr@gtexttrue\dcr@gshieldfalse\fi
  % time (\dcr@tmp is still the relation style)
  \ifx\dcr@tmp\dcr@kw@response\let\dcr@tm\dcr@lmode\else\let\dcr@tm\dcr@dmode\fi
  \dcr@ttextfalse\dcr@tclockfalse
  \ifx\dcr@tm\dcr@kw@none\else
    \ifdcr@classic
      \dcr@ttexttrue
    \else
      \dcr@tclocktrue
      \ifx\dcr@tm\dcr@kw@explicit\dcr@ttexttrue\fi
    \fi
  \fi
  \ifx\dcr@tmp\dcr@kw@response
    \ifdcr@xdeadline\dcr@ttexttrue\fi
  \else
    \ifdcr@xdelay\dcr@ttexttrue\fi
  \fi
  % a delayed relation uses a clock marker instead of its usual one: the
  % style "<marker> delayed" if the relation has one (response: blue square
  % with a clock), else the general clock circle (portal only, not with none)
  \def\dcr@mstyle{#2}%
  \ifx\dcr@delay\@empty\else\ifdcr@tclock
    \pgfkeysifdefined{/tikz/#2 delayed/.@cmd}%
      {\def\dcr@mstyle{#2 delayed}}{\def\dcr@mstyle{dcr/delay marker}}%
  \fi\fi
  \ifdcr@coopis
    \edef\dcr@next{\noexpand\dcr@coopisrelation{\unexpanded{#1}}%
      {\unexpanded\expandafter{\dcr@ropts}}{\unexpanded{#5}}{\unexpanded{#6}}}%
  \else\ifdcr@classic
    \edef\dcr@next{\noexpand\dcr@classicrelation{\unexpanded{#1}}%
      {\unexpanded\expandafter{\dcr@ropts}}{\unexpanded{#5}}{\unexpanded{#6}}}%
  \else
    \edef\dcr@next{\noexpand\dcr@portalrelation{\unexpanded{#1}}%
      {\unexpanded\expandafter{\dcr@mstyle}}{\unexpanded{#3}}%
      {\unexpanded\expandafter{\dcr@ropts}}{\unexpanded{#5}}{\unexpanded{#6}}}%
  \fi\fi
  \dcr@next
  \endgroup}

% ------------------------------------------------------------------
%  Decorations next to a relation marker. Uses the marker centre
%  (\dcr@px,\dcr@py) and the direction pointing away from the box
%  (\dcr@ux,\dcr@uy), both left behind by \dcr@computeend.
%    - delay label, beside the line, just past the marker
%    - guard shield, a bit further along
% ------------------------------------------------------------------
\newlength\dcr@guardsize \setlength\dcr@guardsize{3pt}
\tikzset{
  dcr/delay marker/.style={circle, draw=dcr delay, fill=white,
    line width=0.8pt, inner sep=0pt, minimum size=\dcr@csize,
    path picture={%
      \draw[dcr delay, line width=0.7pt, line cap=round]
        ([yshift=0.28\dcr@csize]path picture bounding box.center) --
        (path picture bounding box.center) --
        ([xshift=0.2\dcr@csize]path picture bounding box.center);}},
  dcr/delay label/.style={font=\dcr@font\bfseries\scriptsize, text=dcr delay,
    inner sep=1pt},
  % timed response (deadline): blue square with a white clock face
  dcr/response marker delayed/.style={dcr/square marker, fill=dcr response,
    path picture={%
      \fill[white] (path picture bounding box.center)
        circle[radius=0.34\dcr@rsize];
      \dcr@clockhands{dcr response}{\dcr@rsize}}},
  dcr/response delay label/.style={text=dcr response},
  % timed condition: the open circle with clock hands inside
  dcr/condition marker delayed/.style={dcr/condition marker,
    path picture={\dcr@clockhands{dcr condition}{\dcr@csize}}},
  % timed pre-condition: the filled dot with a thin white ring and white hands
  dcr/precondition marker delayed/.style={dcr/precondition marker,
    path picture={%
      \draw[white, line width=0.08\dcr@csize] (path picture bounding box.center)
        circle[radius=0.3\dcr@csize];
      \dcr@clockhands{white}{\dcr@csize}}},
  dcr/guard/.style={line width=0.6pt},
  dcr/guard size/.code={\setlength\dcr@guardsize{#1}},
}
\newcommand\dcr@decorate[2]{% #1 relation style, #2 marker half size
  % side for the decorations: the outer side of a bundle of parallel
  % relations (so they don't land on a neighbouring line), otherwise the
  % right-hand side of the line
  \ifdim\dcr@off pt=0pt
    \pgfmathsetmacro\dcr@nx{\dcr@uy}\pgfmathsetmacro\dcr@ny{-\dcr@ux}%
  \else
    \pgfmathsetmacro\dcr@nx{\dcr@ox/abs(\dcr@off)}%
    \pgfmathsetmacro\dcr@ny{\dcr@oy/abs(\dcr@off)}%
  \fi
  \ifx\dcr@delay\@empty\else\ifdcr@ttext   % the time as text, if wanted
    \pgfmathsetmacro\dcr@lx{\dcr@px+(#2+2)*\dcr@ux+5*\dcr@nx}%
    \pgfmathsetmacro\dcr@ly{\dcr@py+(#2+2)*\dcr@uy+5*\dcr@ny}%
    \pgfmathsetmacro\dcr@la{atan2(-\dcr@ny-\dcr@uy,-\dcr@nx-\dcr@ux)}%
    \dcr@thisdelaylabel{#1}%   colour (response: blue)
    \node[dcr/delay label, dcr/this delay label, anchor=\dcr@la]
      at (\dcr@lx pt,\dcr@ly pt) {\dcr@delay};
  \fi\fi
  % the guard shield: for `guard' without expression, and for any guard
  % when guards are shown as shields (guards=shield or both)
  \ifdcr@guard
    \dcr@showshieldfalse
    \ifx\dcr@gexpr\@empty\ifdcr@gallowshield\dcr@showshieldtrue\fi\fi
    \ifdcr@gshield\dcr@showshieldtrue\fi
    \ifdcr@showshield
      \pgfmathsetmacro\dcr@gx{\dcr@px+(#2+\dcr@guardsize+1.5)*\dcr@ux+(#2+\dcr@guardsize)*\dcr@nx}%
      \pgfmathsetmacro\dcr@gy{\dcr@py+(#2+\dcr@guardsize+1.5)*\dcr@uy+(#2+\dcr@guardsize)*\dcr@ny}%
      \dcr@shield{#1}{\dcr@gx pt}{\dcr@gy pt}%
    \fi
  \fi}

% How guards, delays and deadlines are shown, for a document (\dcrset) or
% a graph (\begin{dcrgraph}[dcr/...]). Defaults depend on the notation:
% portal = only the markers (shield, clock), no values; classic = the
% values as text (classic notation has no shields or clocks).
%   guards=shield | explicit | both | none
%   delays=marker | explicit | none       (times of conditions etc.)
%   deadlines=marker | explicit | none    (times of responses)
%   explicit                              all three explicit
% explicit: the value as text (portal: in addition to the marker);
% none: not shown at all. In classic notation, every mode except none
% shows the text. Single relations: the relation key explicit={...}.
\def\dcr@gmode{default}\def\dcr@dmode{default}\def\dcr@lmode{default}
\def\dcr@kw@none{none}\def\dcr@kw@explicit{explicit}\def\dcr@kw@both{both}
\newif\ifdcr@showshield
\newif\ifdcr@gtext \newif\ifdcr@gshield \newif\ifdcr@ttext  % per relation
\newif\ifdcr@gallowshield \newif\ifdcr@tclock
\tikzset{
  dcr/guards/.is choice,
  dcr/guards/shield/.code={\def\dcr@gmode{shield}},
  dcr/guards/explicit/.code={\def\dcr@gmode{explicit}},
  dcr/guards/both/.code={\def\dcr@gmode{both}},
  dcr/guards/none/.code={\def\dcr@gmode{none}},
  dcr/delays/.is choice,
  dcr/delays/marker/.code={\def\dcr@dmode{marker}},
  dcr/delays/explicit/.code={\def\dcr@dmode{explicit}},
  dcr/delays/none/.code={\def\dcr@dmode{none}},
  dcr/deadlines/.is choice,
  dcr/deadlines/marker/.code={\def\dcr@lmode{marker}},
  dcr/deadlines/explicit/.code={\def\dcr@lmode{explicit}},
  dcr/deadlines/none/.code={\def\dcr@lmode{none}},
  dcr/explicit/.code={\def\dcr@gmode{explicit}\def\dcr@dmode{explicit}%
    \def\dcr@lmode{explicit}},
}

% guard expression written halfway along the line, beside it
\newcommand\dcrguardformat[1]{[\,#1\,]}
% (its place, halfway along the line, is given where it is used: the same
% style also writes the guard of a self-relation, which has no line)
\tikzset{dcr/guard label/.style={font=\dcr@font\scriptsize, inner sep=2pt},
  % the relation key guard side=right: the other side of the line
  dcr/guard@side/.code={\ifx\dcr@gside\dcr@kw@right\pgfkeysalso{/tikz/swap}\fi},
  % the guard as a label of a line, halfway along it
  dcr/guard@line/.style={midway, auto, dcr/guard@side, sloped=false, dcr/guard label}}
\def\dcr@kw@right{right}
\newcommand\dcr@guardlabel[4]{% #1 style, #2 tikz options, #3 from, #4 to
  \ifdcr@guard\ifdcr@gtext\ifx\dcr@gexpr\@empty\else
    \ifdcr@auto
      \path (dcr@s) -- node[#1, dcr/guard@line] {\dcrguardformat{\dcr@gexpr}} (dcr@e);
    \else\ifdcr@routed
      % routed relation: halfway along the middle segment
      \dcr@i=\numexpr(\dcr@np-1)/2\relax
      \path (dcr@p\the\dcr@i) -- node[#1, dcr/guard@line]
        {\dcrguardformat{\dcr@gexpr}} (dcr@p\the\numexpr\dcr@i+1\relax);
    \else
      \path[#2] (#3) to node[#1, dcr/guard@line] {\dcrguardformat{\dcr@gexpr}} (#4);
    \fi\fi
  \fi\fi\fi}
% the style dcr/this delay label: "<relation> delay label" if relation
% style #1 has one (response: blue), else nothing extra
\newcommand\dcr@thisdelaylabel[1]{%
  \pgfkeysifdefined{/tikz/#1 delay label/.@cmd}%
    {\tikzset{dcr/this delay label/.style={#1 delay label}}}%
    {\tikzset{dcr/this delay label/.style={}}}}

% The values of a self-relation as text (guard, then the time beyond it),
% outside the box next to its loop or marker: from the point (#2,#3) (in
% pt, without unit) away from the box, to the right or left (#4 = 1 or
% -1) and up or down (#5 = 1 or -1). #1 = relation style. Result:
% \dcr@selfend, the far edge of the text (y in pt; #3 if there is none).
\newcommand\dcr@selflabels[5]{%
  \edef\dcr@sanchor{\ifdim#5pt>0pt south\else north\fi\space
    \ifdim#4pt>0pt west\else east\fi}%
  \edef\dcr@selfend{#3}%
  \ifdcr@guard\ifdcr@gtext\ifx\dcr@gexpr\@empty\else
    \node[#1, dcr/guard label, anchor=\dcr@sanchor] (dcr@sl)
      at (#2pt,\dcr@selfend pt) {\dcrguardformat{\dcr@gexpr}};
    \pgfpointanchor{dcr@sl}{\ifdim#5pt>0pt north\else south\fi}%
    \edef\dcr@selfend{\strip@pt\pgf@y}%
  \fi\fi\fi
  \ifx\dcr@delay\@empty\else\ifdcr@ttext
    \dcr@thisdelaylabel{#1}%
    \node[dcr/delay label, dcr/this delay label, anchor=\dcr@sanchor] (dcr@sl)
      at (#2pt,\dcr@selfend pt) {\dcr@delay};
    \pgfpointanchor{dcr@sl}{\ifdim#5pt>0pt north\else south\fi}%
    \edef\dcr@selfend{\strip@pt\pgf@y}%
  \fi\fi}

% a small shield, half filled, centred at (#2,#3) in the colour of style #1
\newcommand\dcr@shield[3]{%
  \begin{scope}[shift={(#2,#3)}, x=\dcr@guardsize, y=\dcr@guardsize]
    \draw[#1, dcr/guard, fill=white]
      (-1,1) -- (1,1) -- (1,0) .. controls (1,-0.7) and (0.4,-1.1) .. (0,-1.35)
      .. controls (-0.4,-1.1) and (-1,-0.7) .. (-1,0) -- cycle;
    \fill[#1]
      (0,1) -- (1,1) -- (1,0) .. controls (1,-0.7) and (0.4,-1.1) .. (0,-1.35) -- cycle;
  \end{scope}}

% Where the line of a relation runs, for all notations; #1 TikZ options of
% the relation, #2 from, #3 to (node or node.anchor). Results:
%   \ifdcr@auto  spread with other relations between the same boxes (see
%                \dcr@parallel): only for plain node names and no TikZ
%                options (with options such as bend, the user is in charge)
%   (dcr@s), (dcr@e)    start and end, on the outlines
%   (dcr@s2), (dcr@e2)  points a little after the start / before the end,
%                       for the direction of the line there
%   \dcr@line    the path to draw: route, straight line or (#2) to (#3)
\newcommand\dcr@geometry[3]{%
  \dcr@split#2.\@nil\let\dcr@fromnode\dcr@node
  \dcr@split#3.\@nil\let\dcr@tonode\dcr@node
  \dcr@autofalse
  \if\relax\detokenize{#1}\relax\ifdcr@routed\else
    \ifx\dcr@fromnode\dcr@from\ifx\dcr@tonode\dcr@to\dcr@autotrue\fi\fi
  \fi\fi
  \ifdcr@routed
    \dcr@route{#2}{#3}%
    \coordinate (dcr@s) at (dcr@p0);
    \coordinate (dcr@s2) at (dcr@p1);
    \coordinate (dcr@e) at (dcr@p\the\dcr@np);
    \coordinate (dcr@e2) at (dcr@p\the\numexpr\dcr@np-1\relax);
    \let\dcr@line\dcr@ppath
  \else\ifdcr@auto
    \dcr@parallel{#2}{#3}%
    \pgfcoordinate{dcr@s2}{\pgfpointadd{\pgfpointanchor{dcr@s}{center}}%
      {\pgfpoint{5*\dcr@dx pt}{5*\dcr@dy pt}}}%
    \pgfcoordinate{dcr@e2}{\pgfpointadd{\pgfpointanchor{dcr@e}{center}}%
      {\pgfpoint{-5*\dcr@dx pt}{-5*\dcr@dy pt}}}%
    \def\dcr@line{(dcr@s) -- (dcr@e)}%
  \else
    \path[#1] (#2) to coordinate[pos=0] (dcr@s) coordinate[pos=0.03] (dcr@s2)
                      coordinate[pos=0.97] (dcr@e2) coordinate[pos=1] (dcr@e) (#3);
    \def\dcr@line{(#2) to (#3)}%
  \fi\fi}

% #1 line style, #2 marker style, #3 marker half size, #4 TikZ options,
% #5 from, #6 to
\newcommand\dcr@portalrelation[6]{%
  \ifx\dcr@from\dcr@to
    \dcr@portalself{#2}{#5}{#1}{#3}%
  \else
    \dcr@geometry{#4}{#5}{#6}%
    % the marker sits at the target, except for relations flagged with
    % \dcr@atsourcetrue (response: "!" on the activity that causes it)
    \ifdcr@atsource
      \pgfcoordinate{dcr@b}{\pgfpointanchor{dcr@s}{center}}%
      \pgfcoordinate{dcr@a}{\pgfpointanchor{dcr@s2}{center}}%
      \dcr@computeend{#5}{#3}%
      \draw[#1,#4,shorten <=\dcr@t] \dcr@line;
    \else
      \pgfcoordinate{dcr@b}{\pgfpointanchor{dcr@e}{center}}%
      \pgfcoordinate{dcr@a}{\pgfpointanchor{dcr@e2}{center}}%
      \dcr@computeend{#6}{#3}%
      \draw[#1,#4,shorten >=\dcr@t] \dcr@line;
    \fi
    \node[#2] at (\dcr@px pt,\dcr@py pt) {};
    \dcr@decorate{#1}{#3}%
    \dcr@guardlabel{#1}{#4}{#5}{#6}%
  \fi
}

% ------------------------------------------------------------------
%  Parallel edges. Relations between the same two nodes (in either
%  direction) are numbered; the n-th of N is shifted sideways by
%  ((N-1)/2 - n) d (d = parallel distance): even steps, centred on the
%  line between the boxes, so lines and markers never overlap.
%  The shifted line is clipped to both boxes, giving (dcr@s) start and
%  (dcr@e) end, and \dcr@dx, \dcr@dy its direction.
% ------------------------------------------------------------------
\newif\ifdcr@auto
\newif\ifdcr@rerun
\newcount\dcr@graph
\newcount\dcr@isym   % inline symbols, see \dcr@inlinebox
% totals of parallel relations, read back from the .aux file
\def\dcr@auxtot#1#2{\expandafter\gdef\csname dcr@tot@#1\endcsname{#2}}
\AtBeginDocument{\immediate\write\@auxout{\string\providecommand\string\dcr@auxtot[2]{}}}
\AtEndDocument{\ifdcr@rerun\PackageWarningNoLine{dcrgraph}{Parallel relations
  have changed. Rerun LaTeX to get them right}\fi}
\newif\ifdcr@atsource
\newif\ifdcr@inlinesym   % drawing an inline symbol (\dcrcondition etc.)
\newlength\dcr@pardist \setlength\dcr@pardist{13.5pt}  % portal: 21px
\tikzset{dcr/parallel distance/.code={\setlength\dcr@pardist{#1}}}
\newcount\dcr@n
\newdimen\dcr@wA \newdimen\dcr@hA \newdimen\dcr@wB \newdimen\dcr@hB

\def\dcr@bsplit#1:#2:#3:#4:#5:#6\@nil{%
  \def\dcr@bnode{#1}\def\dcr@bname{#2}\def\dcr@bidx{#3}\def\dcr@btot{#4}%
  \def\dcr@bcentre{#5}}
\newcommand\dcr@parallel[2]{%
  % which relation between these two is this, and in which direction?
  % (counters are per graph, so node names can be reused in other graphs)
  \def\dcr@sign{1}\def\dcr@bidx{}%
  \ifx\dcr@bundle\@empty
  \ifcsname dcr@pair@\the\dcr@graph|#1|#2\endcsname
    \dcr@n=\csname dcr@pair@\the\dcr@graph|#1|#2\endcsname\relax
    \edef\dcr@key{\the\dcr@graph|#1|#2}%
  \else\ifcsname dcr@pair@\the\dcr@graph|#2|#1\endcsname
    \dcr@n=\csname dcr@pair@\the\dcr@graph|#2|#1\endcsname\relax
    \edef\dcr@key{\the\dcr@graph|#2|#1}\def\dcr@sign{-1}%
  \else
    \dcr@n=0 \edef\dcr@key{\the\dcr@graph|#1|#2}%
  \fi\fi
  \else
    % bundle=<node>:<name>[:<position>:<count>[:<centre>]]: relations with a common
    % end <node> whose lines or markers would lie on top of each other,
    % spread like parallel relations; the side is counted from <node>.
    % With a position (0 = the leftmost, seen from <node>) and the count,
    % that position is used (the converter sorts them geometrically, so
    % neighbours never cross); without, the order of writing (as for
    % parallel relations, with the count from the last run).
    \expandafter\dcr@bsplit\dcr@bundle:::::\@nil
    \edef\dcr@key{\the\dcr@graph|bundle|\dcr@bnode:\dcr@bname}%
    \ifx\dcr@bidx\@empty
      \ifcsname dcr@pair@\dcr@key\endcsname
        \dcr@n=\csname dcr@pair@\dcr@key\endcsname\relax
      \else
        \dcr@n=0
      \fi
    \else
      \dcr@n=\dcr@bidx\relax
    \fi
    \def\dcr@tmp{#1}\ifx\dcr@tmp\dcr@bnode\else\def\dcr@sign{-1}\fi
  \fi
  % The total number of relations between the pair comes from the last
  % run (.aux), so the bundle can be centred: the first relation written
  % is on one side, the last on the other, in the order of the source.
  % (Inline symbols know their number, \dcr@itotal, and use no .aux: in a
  % table that is typeset several times, e.g. tabularx, they would never
  % match the last run.)
  \ifx\dcr@bidx\@empty
  \ifdcr@inlinesym
    \let\dcr@total\dcr@itotal
  \else\ifcsname dcr@tot@\dcr@key\endcsname
    \edef\dcr@total{\csname dcr@tot@\dcr@key\endcsname}%
    \ifnum\dcr@n<\dcr@total\relax\else\global\dcr@reruntrue\fi
  \else
    \edef\dcr@total{\the\numexpr\dcr@n+1\relax}\global\dcr@reruntrue
  \fi\fi
  \pgfmathsetmacro\dcr@off{\dcr@sign*((\dcr@total-1)/2-\dcr@n)*\dcr@pardist}%
  \advance\dcr@n 1
  \expandafter\xdef\csname dcr@pair@\dcr@key\endcsname{\the\dcr@n}%
  \ifdcr@inlinesym\else
    \immediate\write\@auxout{\string\dcr@auxtot{\dcr@key}{\the\dcr@n}}%
  \fi
  \else   % position and count given (bundle=node:name:position:count
          % [:centre]); the centre (in positions) defaults to the middle
    \let\dcr@total\dcr@btot
    \ifx\dcr@bcentre\@empty
      \pgfmathsetmacro\dcr@off{\dcr@sign*((\dcr@total-1)/2-\dcr@n)*\dcr@pardist}%
    \else
      \pgfmathsetmacro\dcr@off{\dcr@sign*(\dcr@bcentre-\dcr@n)*\dcr@pardist}%
    \fi
  \fi
  % centres and half sizes of both boxes
  \pgfpointanchor{#1}{center}\dcr@ax=\pgf@x \dcr@ay=\pgf@y
  \pgfpointanchor{#1}{north east}\dcr@wA=\pgf@x \dcr@hA=\pgf@y
  \advance\dcr@wA-\dcr@ax \advance\dcr@hA-\dcr@ay
  \pgfpointanchor{#2}{center}\dcr@bx=\pgf@x \dcr@by=\pgf@y
  \pgfpointanchor{#2}{north east}\dcr@wB=\pgf@x \dcr@hB=\pgf@y
  \advance\dcr@wB-\dcr@bx \advance\dcr@hB-\dcr@by
  % direction A -> B and sideways shift
  \pgfmathsetmacro\dcr@dx{\dcr@bx-\dcr@ax}%
  \pgfmathsetmacro\dcr@dy{\dcr@by-\dcr@ay}%
  \pgfmathsetmacro\dcr@l{max(veclen(\dcr@dx,\dcr@dy),0.001)}%
  \pgfmathsetmacro\dcr@dx{\dcr@dx/\dcr@l}%
  \pgfmathsetmacro\dcr@dy{\dcr@dy/\dcr@l}%
  % safety: the shifted line must still hit both boxes, with room for a
  % marker -- limit the shift to what the narrower box allows across the
  % line (its half extent perpendicular to the line)
  \pgfmathsetmacro\dcr@lim{max(min(\dcr@wA*abs(\dcr@dy)+\dcr@hA*abs(\dcr@dx),
    \dcr@wB*abs(\dcr@dy)+\dcr@hB*abs(\dcr@dx))-0.5*\dcr@rsize-\dcr@border, 0)}%
  \pgfmathsetmacro\dcr@off{max(min(\dcr@off,\dcr@lim),-\dcr@lim)}%
  \pgfmathsetmacro\dcr@ox{-\dcr@dy*\dcr@off}%
  \pgfmathsetmacro\dcr@oy{\dcr@dx*\dcr@off}%
  % leave box A: distance along the line from the shifted centre
  \dcr@exit{\dcr@wA}{\dcr@hA}{\dcr@dx}{\dcr@dy}%
  \pgfmathsetmacro\dcr@sx{\dcr@ax+\dcr@ox+\dcr@te*\dcr@dx}%
  \pgfmathsetmacro\dcr@sy{\dcr@ay+\dcr@oy+\dcr@te*\dcr@dy}%
  % enter box B (= leave it going backwards)
  \dcr@exit{\dcr@wB}{\dcr@hB}{-\dcr@dx}{-\dcr@dy}%
  \pgfmathsetmacro\dcr@ex{\dcr@bx+\dcr@ox-\dcr@te*\dcr@dx}%
  \pgfmathsetmacro\dcr@ey{\dcr@by+\dcr@oy-\dcr@te*\dcr@dy}%
  \pgfcoordinate{dcr@s}{\pgfpoint{\dcr@sx pt}{\dcr@sy pt}}%
  \pgfcoordinate{dcr@e}{\pgfpoint{\dcr@ex pt}{\dcr@ey pt}}%
}

% distance from (centre + sideways shift) to the border of a box with
% half sizes #1 x #2, going in direction (#3,#4); result in \dcr@te
\newcommand\dcr@exit[4]{%
  \pgfmathsetmacro\dcr@ux{#3}\pgfmathsetmacro\dcr@uy{#4}%
  \ifdim\dimexpr\ifdim\dcr@ux pt<0pt -\fi\dcr@ux pt\relax<0.0001pt
    \def\dcr@tx{10000}%
  \else
    \pgfmathsetmacro\dcr@tx{((\dcr@ux>0 ? #1 : -#1)-\dcr@ox)/\dcr@ux}%
  \fi
  \ifdim\dimexpr\ifdim\dcr@uy pt<0pt -\fi\dcr@uy pt\relax<0.0001pt
    \def\dcr@ty{10000}%
  \else
    \pgfmathsetmacro\dcr@ty{((\dcr@uy>0 ? #2 : -#2)-\dcr@oy)/\dcr@uy}%
  \fi
  \pgfmathsetmacro\dcr@te{max(min(\dcr@tx,\dcr@ty),0)}%
}

% ------------------------------------------------------------------
%  Routed relations:  \condition[via={(x1,y1),(x2,y2)}]{A}{B}
%  The line runs from box A through the given points to box B. A first
%  or last point that lies on a box outline (within 2pt, as in files
%  from DCR-js) is where the line leaves/enters that box, so right-angled
%  routes stay right-angled. Result: the polyline as coordinates
%  dcr@p0 (on A) ... dcr@p<\dcr@np> (on B), and \dcr@ppath to draw it.
%  Points are plain coordinates, (1,2) or (A.north); no ($...$).
% ------------------------------------------------------------------
\newcount\dcr@nv \newcount\dcr@np \newcount\dcr@i \newcount\dcr@vlast
\def\dcr@vp@next{\@ifnextchar(\dcr@vp@one\dcr@vp@stop}
\def\dcr@vp@one(#1){\advance\dcr@nv 1
  \coordinate (dcr@v\the\dcr@nv) at (#1);%
  \@ifnextchar,\dcr@vp@comma\dcr@vp@next}
\def\dcr@vp@comma,{\dcr@vp@next}
\def\dcr@vp@stop#1\dcr@vp@end{}
% coordinate #1 -> x, y in pt (without unit) into #2, #3
\def\dcr@xy#1#2#3{\pgfpointanchor{#1}{center}%
  \edef#2{\strip@pt\pgf@x}\edef#3{\strip@pt\pgf@y}}
% #1 = point on (or near) a box outline, #2 = its neighbour on the route,
% #3 = the box border point towards #1, #4 = name of the new coordinate.
% If #1 is on the outline, #4 = #1 moved onto the node border (outer sep)
% in the direction of the route, and \dcr@onbordertrue; else #4 = #3.
\newif\ifdcr@onborder
\newcommand\dcr@endpoint[4]{%
  \dcr@xy{#1}\dcr@wx\dcr@wy \dcr@xy{#3}\dcr@wbx\dcr@wby
  \pgfmathsetmacro\dcr@wd{veclen(\dcr@wx-\dcr@wbx,\dcr@wy-\dcr@wby)}%
  \ifdim\dcr@wd pt<2pt
    \dcr@onbordertrue
    \dcr@xy{#2}\dcr@wqx\dcr@wqy
    \pgfmathsetmacro\dcr@wl{max(veclen(\dcr@wx-\dcr@wqx,\dcr@wy-\dcr@wqy),0.001)}%
    \pgfmathsetmacro\dcr@wx{\dcr@wx+\dcr@wd*(\dcr@wx-\dcr@wqx)/\dcr@wl}%
    \pgfmathsetmacro\dcr@wy{\dcr@wy+\dcr@wd*(\dcr@wy-\dcr@wqy)/\dcr@wl}%
    \coordinate (#4) at (\dcr@wx pt,\dcr@wy pt);
  \else
    \dcr@onborderfalse
    \coordinate (#4) at (#3);
  \fi}
\newcommand\dcr@route[2]{% #1 from, #2 to (the points: see \dcr@relation)
  % where the outlines are on the way to the first and last point
  \path (dcr@v1) -- coordinate[pos=1] (dcr@sb) (#1);
  \path (dcr@v\the\dcr@nv) -- coordinate[pos=1] (dcr@eb) (#2);
  % start
  \ifnum\dcr@nv>1 \def\dcr@wn{dcr@v2}\else\def\dcr@wn{dcr@eb}\fi
  \dcr@endpoint{dcr@v1}{\dcr@wn}{dcr@sb}{dcr@p0}%
  \ifdcr@onborder\dcr@i=2 \else\dcr@i=1 \fi
  % end: is the last point on the outline of the target?
  \ifnum\dcr@nv>1 \def\dcr@wn{dcr@v\the\numexpr\dcr@nv-1\relax}\else\def\dcr@wn{dcr@p0}\fi
  \dcr@endpoint{dcr@v\the\dcr@nv}{\dcr@wn}{dcr@eb}{dcr@we}%
  \dcr@vlast=\dcr@nv \ifdcr@onborder\advance\dcr@vlast-1 \fi
  % points in between
  \dcr@np=0 \def\dcr@ppath{(dcr@p0)}%
  \loop\ifnum\dcr@i>\dcr@vlast\else
    \advance\dcr@np 1
    \coordinate (dcr@p\the\dcr@np) at (dcr@v\the\dcr@i);
    \edef\dcr@ppath{\dcr@ppath -- (dcr@p\the\dcr@np)}%
    \advance\dcr@i 1
  \repeat
  \advance\dcr@np 1
  \coordinate (dcr@p\the\dcr@np) at (dcr@we);
  \edef\dcr@ppath{\dcr@ppath -- (dcr@p\the\dcr@np)}%
  \pgfmathsetmacro\dcr@rs{\dcr@rshift}%
  \ifdim\dcr@rs pt=0pt \else\dcr@shiftroute\fi
}
% unit direction from dcr@p#1 to dcr@p#2 -> macros #3, #4
\newcommand\dcr@segdir[4]{%
  \dcr@xy{dcr@p#1}\dcr@wx\dcr@wy \dcr@xy{dcr@p#2}\dcr@wqx\dcr@wqy
  \pgfmathsetmacro\dcr@wl{max(veclen(\dcr@wqx-\dcr@wx,\dcr@wqy-\dcr@wy),0.001)}%
  \pgfmathsetmacro#3{(\dcr@wqx-\dcr@wx)/\dcr@wl}%
  \pgfmathsetmacro#4{(\dcr@wqy-\dcr@wy)/\dcr@wl}}
% the route dcr@p0 ... moved sideways by \dcr@rs (pt, to the left of the
% direction of travel); each corner along its bisector, so every segment
% stays parallel to the original one (and ends on a box outline stay on
% it when the route leaves the box at a right angle)
\newcommand\dcr@shiftroute{%
  \dcr@i=0
  \loop\ifnum\dcr@i>\dcr@np\else
    % the segments before and after point i (at an end: the one segment)
    \ifnum\dcr@i>0
      \dcr@segdir{\the\numexpr\dcr@i-1\relax}{\the\dcr@i}\dcr@dax\dcr@day
    \else
      \dcr@segdir{0}{1}\dcr@dax\dcr@day
    \fi
    \ifnum\dcr@i<\dcr@np
      \dcr@segdir{\the\dcr@i}{\the\numexpr\dcr@i+1\relax}\dcr@dbx\dcr@dby
    \else
      \let\dcr@dbx\dcr@dax \let\dcr@dby\dcr@day
    \fi
    % offset = shift * (na + nb) / (1 + na.nb), n = left normal (-dy, dx)
    \pgfmathsetmacro\dcr@dk{\dcr@rs/max(1+\dcr@dax*\dcr@dbx+\dcr@day*\dcr@dby,0.2)}%
    \dcr@xy{dcr@p\the\dcr@i}\dcr@wx\dcr@wy
    \coordinate (dcr@q\the\dcr@i) at
      (\dcr@wx pt-\dcr@dk*\dcr@day pt-\dcr@dk*\dcr@dby pt,
       \dcr@wy pt+\dcr@dk*\dcr@dax pt+\dcr@dk*\dcr@dbx pt);
    \advance\dcr@i 1
  \repeat
  \dcr@i=0
  \loop\ifnum\dcr@i>\dcr@np\else
    \coordinate (dcr@p\the\dcr@i) at (dcr@q\the\dcr@i);
    \advance\dcr@i 1
  \repeat}

% Relation from an activity to itself (e.g. \exclude{A}{A}): no line, just
% the marker on the top edge, as in the DCR portal. Several self-relations
% on one activity are lined up left to right from the left corner; with
% the relation key selfpos=<length> (distance of the marker's centre from
% the left edge; set by \includedcrgraph to avoid the markers of other
% relations) at that place instead.
\newdimen\dcr@selfx
\def\dcr@selfgap{2pt}   % between two self-relation markers
% \dimen@ (the centre of a marker on the top edge of node #1) moved right
% until it keeps a marker and the gap from every marker placed there with
% selfpos=
\newif\ifdcr@moved
\newcommand\dcr@selffree[1]{%
  \ifcsname dcr@selfused@\the\dcr@graph @#1\endcsname
    \edef\dcr@used{\csname dcr@selfused@\the\dcr@graph @#1\endcsname}%
    \loop
      \dcr@movedfalse
      \@for\dcr@u:=\dcr@used\do{%
        \dimen2=\dimexpr\dimen@-\dcr@u\relax
        \ifdim\dimen2<0pt \dimen2=-\dimen2 \fi
        \ifdim\dimen2<\dimexpr\dcr@rsize+\dcr@selfgap-0.01pt\relax
          \dimen@=\dimexpr\dcr@u+\dcr@rsize+\dcr@selfgap\relax
          \dcr@movedtrue
        \fi}%
    \ifdcr@moved\repeat
  \fi}
% #1 marker style, #2 node, #3 relation style, #4 marker half size. A
% guard shield sits right of the marker, as on a line; the values as text
% above it (several self-relations of a box: each one's text above the
% text of the one before, so they never overlap).
\newcommand\dcr@portalself[4]{%
  \ifcsname dcr@self@\the\dcr@graph @#2\endcsname
    \dcr@selfx=\csname dcr@self@\the\dcr@graph @#2\endcsname\relax
  \else
    \dcr@selfx=0pt
  \fi
  % \dimen@: the marker's centre from the left edge
  \ifx\dcr@selfpos\@empty
    \dimen@=\dimexpr\dcr@selfx+0.5\dcr@rsize\relax
    \dcr@selffree{#2}%
    \dcr@selfx=\dimexpr\dimen@+0.5\dcr@rsize+\dcr@selfgap\relax
    \expandafter\xdef\csname dcr@self@\the\dcr@graph @#2\endcsname{\the\dcr@selfx}%
  \else
    % at the given place, which later markers of the box leave free
    \dimen@=\dcr@selfpos\relax
    \edef\dcr@used{%   (built first: \csname would define it as \relax)
      \ifcsname dcr@selfused@\the\dcr@graph @#2\endcsname
        \csname dcr@selfused@\the\dcr@graph @#2\endcsname,\fi\the\dimen@}%
    \expandafter\global\expandafter\let
      \csname dcr@selfused@\the\dcr@graph @#2\endcsname\dcr@used
  \fi
  % the marker: flush on the top edge, exactly like the other markers (as
  % in the portal); by its centre, so that dots and squares line up
  \node[#1, anchor=center]
    at ([xshift=\dimen@, yshift=0.5\dcr@border+\dcr@gap+0.5\dcr@rsize]#2.north west) {};
  \pgfpointanchor{#2}{north west}%
  \pgfmathsetmacro\dcr@px{\pgf@x+\dimen@}%
  \pgfmathsetmacro\dcr@py{\pgf@y+0.5*\dcr@border+\dcr@gap+0.5*\dcr@rsize}%
  % the shield: \dcr@decorate with the direction away from the box (up)
  \def\dcr@ux{0}\def\dcr@uy{1}\def\dcr@off{0}%
  \begingroup\dcr@ttextfalse\dcr@decorate{#3}{#4}\endgroup
  % the text starts above the markers and above the row of shields (also
  % of self-relations that come later; coopis23, which uses this too, has
  % no shields)
  \pgfmathsetmacro\dcr@sy{\dcr@py+#4+1}%
  \ifdcr@classic\else\pgfmathsetmacro\dcr@sy{\dcr@sy+2.6*\dcr@guardsize}\fi
  \ifcsname dcr@selfend@\the\dcr@graph @#2\endcsname
    \pgfmathsetmacro\dcr@sy{max(\dcr@sy,
      \csname dcr@selfend@\the\dcr@graph @#2\endcsname+1)}%
  \fi
  \pgfmathsetmacro\dcr@sx{\dcr@px-#4}%
  \dcr@selflabels{#3}{\dcr@sx}{\dcr@sy}{1}{1}%
  \ifx\dcr@selfend\dcr@sy\else
    \expandafter\xdef\csname dcr@selfend@\the\dcr@graph @#2\endcsname{\dcr@selfend}%
  \fi
}


% ------------------------------------------------------------------
%  Classic notation (relations only). An arrow with a filled triangle
%  head; the relation symbol sits AFTER the arrowhead, flush against the
%  target box (->•, ->+, ->%, ->◇), and the response dot sits flush
%  against the source box (•->). Each relation command sets
%    \dcr@csrc   dot | (empty)            marker at the source
%    \dcr@ctgt   dot | diamond | sym | (empty)  marker at the target
%    \dcr@csym   the text for sym (+, %, =, x)
%  Symbols stay upright and use the same flush placement as the portal
%  markers, so they never float away from the line.
% ------------------------------------------------------------------
\def\dcr@csrc{}\def\dcr@ctgt{}\def\dcr@csym{}
\newlength\dcr@tend \newlength\dcr@tstart
\tikzset{
  dcr/classic tip/.style={-{Triangle[length=7pt,width=6.5pt]}},
  dcr/classic dot/.style={circle, fill, draw=none, inner sep=0pt,
    minimum size=2\dcr@chalf},
  dcr/classic diamond/.style={diamond, draw, fill=white, inner sep=0pt,
    minimum width=2.5\dcr@chalf, minimum height=2.5\dcr@chalf, line width=0.9pt},
  dcr/classic symbol/.style={font=\dcr@font\bfseries\small, inner sep=0pt},
  dcr/classic marker size/.code={\setlength\dcr@chalf{0.5\dimexpr#1\relax}},
}
\newlength\dcr@chalf \setlength\dcr@chalf{3.2pt}   % half size of the symbols

% draw the target marker (\dcr@ctgt) at the flush position computed by
% \dcr@computeend; #1 = relation style
% The marker is turned to the angle of the line at its end (\dcr@ang),
% so it sits on the line like an arrow tip, also on diagonal and bent edges.
\def\dcr@ang{0}
\newcommand\dcr@classictgtnode[1]{%
  \def\dcr@tmp{dot}\ifx\dcr@ctgt\dcr@tmp
    \node[#1, dcr/classic dot] at (\dcr@px pt,\dcr@py pt) {};\fi
  \def\dcr@tmp{diamond}\ifx\dcr@ctgt\dcr@tmp
    \node[#1, dcr/classic diamond, rotate=\dcr@ang] at (\dcr@px pt,\dcr@py pt) {};\fi
  \def\dcr@tmp{sym}\ifx\dcr@ctgt\dcr@tmp
    \node[#1, dcr/classic symbol, rotate=\dcr@ang] at (\dcr@px pt,\dcr@py pt) {\dcr@csym};\fi
}

\newcommand\dcr@classicrelation[4]{% #1 line style, #2 options, #3 from, #4 to
  \ifx\dcr@from\dcr@to
    \dcr@classicself{#1}{}{#3}%
  \else
    \dcr@geometry{#2}{#3}{#4}%
    % ---- source dot (response, no-response) ----
    \setlength\dcr@tstart{0.5\dcr@border}%
    \ifx\dcr@csrc\@empty\else
      \pgfcoordinate{dcr@b}{\pgfpointanchor{dcr@s}{center}}%
      \pgfcoordinate{dcr@a}{\pgfpointanchor{dcr@s2}{center}}%
      \dcr@computeend{#3}{\dcr@chalf}%
      \node[#1, dcr/classic dot] at (\dcr@px pt,\dcr@py pt) {};
      \setlength\dcr@tstart{\dcr@t}%
      \ifx\dcr@ctgt\@empty\dcr@decorate{#1}{\dcr@chalf}\fi
    \fi
    % ---- target symbol after the arrowhead ----
    \setlength\dcr@tend{0.5\dcr@border}%
    \ifx\dcr@ctgt\@empty\else
      \pgfcoordinate{dcr@b}{\pgfpointanchor{dcr@e}{center}}%
      \pgfcoordinate{dcr@a}{\pgfpointanchor{dcr@e2}{center}}%
      \dcr@computeend{#4}{\dcr@chalf}%
      \pgfmathsetmacro\dcr@ang{atan2(-\dcr@uy,-\dcr@ux)}%
      \dcr@classictgtnode{#1}%
      \dcr@decorate{#1}{\dcr@chalf}%
      \setlength\dcr@tend{\dimexpr\dcr@t+\dcr@chalf+0.6pt\relax}%
    \fi
    % ---- the arrow ----
    \draw[#1, dcr/classic tip, dcr/classic arrow, #2,
          shorten >=\dcr@tend, shorten <=\dcr@tstart] \dcr@line;
    \dcr@guardlabel{#1}{#2}{#3}{#4}%
  \fi}

% Self-relations in classic notation: a loop at a corner, from the top
% (or bottom) edge round to the side edge; markers flush as above. The
% corners are used in turn (top right, top left, bottom right, bottom left).
\newcount\dcr@k
% the loop: from the corner \dcr@loopa along both edges, a curve with
% control points \dcr@loopb out from the box
\def\dcr@loopa{0.5cm}\def\dcr@loopb{1.1cm}
% the key corner=...: this corner instead of the next one in turn
\def\dcr@corner{}
\def\dcr@cornerNE{north east}\def\dcr@cornerNW{north west}
\def\dcr@cornerSE{south east}\def\dcr@cornerSW{south west}
\newcommand\dcr@usecorner[1]{% #1 node
  \ifx\dcr@corner\@empty\else
    \ifx\dcr@corner\dcr@cornerNE \def\dcr@sx{1}\def\dcr@sy{1}%
    \else\ifx\dcr@corner\dcr@cornerNW \def\dcr@sx{-1}\def\dcr@sy{1}%
    \else\ifx\dcr@corner\dcr@cornerSE \def\dcr@sx{1}\def\dcr@sy{-1}%
    \else\ifx\dcr@corner\dcr@cornerSW \def\dcr@sx{-1}\def\dcr@sy{-1}%
    \else
      \PackageError{dcrgraph}{corner=\dcr@corner: use north east, north
        west, south east or south west}{}%
    \fi\fi\fi\fi
    \let\dcr@c\dcr@corner
  \fi
  \expandafter\gdef\csname dcr@cused@\the\dcr@graph @#1@\dcr@c\endcsname{}}
% self-relations take the corners in turn, skipping a corner already used
% by another self-relation of the box (e.g. one given with corner=); when
% all four are used, the turn alone decides. #1 node, #2 corner, #3 #4 the
% signs of x and y towards it
\newcommand\dcr@trycorner[4]{%
  \ifx\dcr@c\@empty
    \ifcsname dcr@cused@\the\dcr@graph @#1@#2\endcsname\else
      \def\dcr@c{#2}\def\dcr@sx{#3}\def\dcr@sy{#4}%
    \fi
  \fi}
\newcommand\dcr@classicself[3]{%
  \ifcsname dcr@cself@\the\dcr@graph @#3\endcsname
    \dcr@k=\csname dcr@cself@\the\dcr@graph @#3\endcsname\relax
  \else \dcr@k=0 \fi
  \def\dcr@c{}%
  \dcr@trycorner{#3}{north east}{1}{1}\dcr@trycorner{#3}{north west}{-1}{1}%
  \dcr@trycorner{#3}{south east}{1}{-1}\dcr@trycorner{#3}{south west}{-1}{-1}%
  \ifx\dcr@c\@empty
  \ifcase\dcr@k \def\dcr@c{north east}\def\dcr@sx{1}\def\dcr@sy{1}%
  \or           \def\dcr@c{north west}\def\dcr@sx{-1}\def\dcr@sy{1}%
  \or           \def\dcr@c{south east}\def\dcr@sx{1}\def\dcr@sy{-1}%
  \else         \def\dcr@c{south west}\def\dcr@sx{-1}\def\dcr@sy{-1}\fi
  \fi
  \dcr@usecorner{#3}%
  \coordinate (dcr@ls) at ([xshift=-\dcr@sx*\dcr@loopa]#3.\dcr@c);  % on top/bottom edge
  \coordinate (dcr@le) at ([yshift=-\dcr@sy*\dcr@loopa]#3.\dcr@c);  % on the side edge
  \setlength\dcr@tstart{0.5\dcr@border}%
  \ifx\dcr@csrc\@empty\else
    \node[#1, dcr/classic dot]
      at ([yshift=\dcr@sy*(\dcr@chalf+0.5\dcr@border)]dcr@ls) {};
    \setlength\dcr@tstart{\dimexpr\dcr@chalf+0.5\dcr@border\relax}%
  \fi
  \setlength\dcr@tend{0.5\dcr@border}%
  \ifx\dcr@ctgt\@empty\else
    \pgfpointanchor{dcr@le}{center}%
    \pgfmathsetmacro\dcr@px{\pgf@x+\dcr@sx*(\dcr@chalf+0.5*\dcr@border)}%
    \pgfmathsetmacro\dcr@py{\pgf@y}%
    \pgfmathsetmacro\dcr@ang{\dcr@sx>0 ? 180 : 0}%
    \dcr@classictgtnode{#1}%
    \setlength\dcr@tend{\dimexpr2\dcr@chalf+0.5\dcr@border+0.6pt\relax}%
  \fi
  \draw[#1, dcr/classic tip, dcr/classic arrow,
        shorten >=\dcr@tend, shorten <=\dcr@tstart]
    (dcr@ls) .. controls +(0,\dcr@sy*\dcr@loopb) and +(\dcr@sx*\dcr@loopb,0) .. (dcr@le);
  % values as text: just beyond the loop's outermost point (the middle of
  % the curve, (3 loopb - 4 loopa)/8 diagonally out from the corner),
  % away from the box
  \pgfpointanchor{#3}{\dcr@c}%
  \edef\dcr@lx{\strip@pt\pgf@x}\edef\dcr@ly{\strip@pt\pgf@y}%
  \pgfmathsetmacro\dcr@lm{(3*\dcr@loopb-4*\dcr@loopa)/8+2pt}%
  \pgfmathsetmacro\dcr@lx{\dcr@lx+\dcr@sx*\dcr@lm}%
  \pgfmathsetmacro\dcr@ly{\dcr@ly+\dcr@sy*\dcr@lm}%
  \dcr@selflabels{#1}{\dcr@lx}{\dcr@ly}{\dcr@sx}{\dcr@sy}%
  \advance\dcr@k 1
  \expandafter\xdef\csname dcr@cself@\the\dcr@graph @#3\endcsname{\the\dcr@k}%
}

% ------------------------------------------------------------------
%  CoopIS2023 notation (relations only), the proposal of "Designing
%  Semantically Transparent Declarative Process Constraints" (CoopIS
%  2023), as drawn by
%  DCR-js: a triangle at the SOURCE (its base flush on the box, pointing
%  along the line; milestone: hollow with a "!") and a circle with the
%  relation's symbol at the TARGET (condition and milestone: a key,
%  response "!", include "+", exclude "-"). update, no-response, spawn and
%  logical include ("±") are not in the proposal; they get their portal
%  symbol in the circle. Like classic otherwise: pre-conditions are
%  translated, values are shown as text. Symbols stay upright.
% ------------------------------------------------------------------
\newlength\dcr@thalf  % half the length of the source triangle
\newlength\dcr@twhalf % half its width
\newlength\dcr@tchalf % half the size of the target circle
\newlength\dcr@tbend  \setlength\dcr@tbend{0pt}  % see dcr/coopis bend
\newif\ifdcr@hollow
% coloured rectangle in a circle; #1 colour, #2..#5 = x1,y1,x2,y2 as
% fractions of the marker size, from its centre
\newcommand\dcr@tglyph[5]{%
  \fill[#1]
    ([shift={(#2\dcr@csize,#3\dcr@csize)}]path picture bounding box.center)
    rectangle
    ([shift={(#4\dcr@csize,#5\dcr@csize)}]path picture bounding box.center);}
\tikzset{
  % the lines; a round cap, so that a steep line ends neatly in the tip of
  % the triangle (the end at the circle is hidden under the circle)
  dcr/coopis line/.style={line cap=round},
  % 0pt (default): straight lines whose start depends on their angle;
  % a radius: the line leaves the triangle's tip straight out and turns
  % into its own direction with a bend of this radius
  dcr/coopis bend/.code={\setlength\dcr@tbend{#1}},
  dcr/coopis circle/.style={circle, fill=white, inner sep=0pt,
    line width=0.1\dcr@csize, minimum size=0.9\dcr@csize},
  dcr/coopis key/.style={% #1 colour
    path picture={%
      \draw[#1, line width=0.07\dcr@csize, line cap=butt]
        ([xshift=-0.14\dcr@csize]path picture bounding box.center)
          circle[radius=0.085\dcr@csize]
        ([xshift=-0.055\dcr@csize]path picture bounding box.center) --
        ([xshift=0.27\dcr@csize]path picture bounding box.center) --
        ([xshift=0.27\dcr@csize,yshift=-0.12\dcr@csize]path picture bounding box.center)
        ([xshift=0.15\dcr@csize]path picture bounding box.center) --
        ([xshift=0.15\dcr@csize,yshift=-0.09\dcr@csize]path picture bounding box.center);}},
  dcr/condition coopis marker/.style={dcr/coopis circle,
    draw=dcr condition, dcr/coopis key=dcr condition},
  dcr/milestone coopis marker/.style={dcr/coopis circle,
    draw=dcr milestone, dcr/coopis key=dcr milestone},
  dcr/response coopis marker/.style={dcr/coopis circle,
    draw=dcr response, path picture={%
      \dcr@tglyph{dcr response}{-0.055}{-0.03}{0.055}{0.24}%
      \dcr@tglyph{dcr response}{-0.055}{-0.24}{0.055}{-0.13}}},
  dcr/include coopis marker/.style={dcr/coopis circle,
    draw=dcr include, path picture={%
      \dcr@tglyph{dcr include}{-0.24}{-0.055}{0.24}{0.055}%
      \dcr@tglyph{dcr include}{-0.055}{-0.24}{0.055}{0.24}}},
  % logical include: "±", a plus with a bar below it
  dcr/logical include coopis marker/.style={dcr/coopis circle,
    draw=dcr logical include, path picture={%
      \dcr@tglyph{dcr logical include}{-0.22}{0.025}{0.22}{0.125}%
      \dcr@tglyph{dcr logical include}{-0.05}{-0.145}{0.05}{0.295}%
      \dcr@tglyph{dcr logical include}{-0.22}{-0.285}{0.22}{-0.185}}},
  dcr/exclude coopis marker/.style={dcr/coopis circle,
    draw=dcr exclude, path picture={%
      \dcr@tglyph{dcr exclude}{-0.24}{-0.055}{0.24}{0.055}}},
  dcr/update coopis marker/.style={dcr/coopis circle,
    draw=dcr update, path picture={%
      \dcr@tglyph{dcr update}{-0.22}{0.04}{0.22}{0.14}%
      \dcr@tglyph{dcr update}{-0.22}{-0.14}{0.22}{-0.04}}},
  dcr/noresponse coopis marker/.style={dcr/coopis circle,
    draw=dcr noresponse, path picture={%
      \draw[dcr noresponse, line width=0.11\dcr@csize]
        ([shift={(-0.17\dcr@csize,-0.17\dcr@csize)}]path picture bounding box.center) --
        ([shift={(0.17\dcr@csize,0.17\dcr@csize)}]path picture bounding box.center)
        ([shift={(-0.17\dcr@csize,0.17\dcr@csize)}]path picture bounding box.center) --
        ([shift={(0.17\dcr@csize,-0.17\dcr@csize)}]path picture bounding box.center);}},
  dcr/spawn coopis marker/.style={dcr/coopis circle,
    draw=dcr spawn, path picture={%
      \foreach \dcr@a in {90,30,-30}{%
        \draw[dcr spawn, line width=0.1\dcr@csize]
          ([shift={(\dcr@a:0.24\dcr@csize)}]path picture bounding box.center) --
          ([shift={(\dcr@a+180:0.24\dcr@csize)}]path picture bounding box.center);}}},
  dcr/coopis marker/.style={dcr/coopis circle, draw},  % any other
}

% the triangle at the source; #1 relation style, #2,#3 its centre (pt),
% #4,#5 unit vector along the line, away from the box
\newcommand\dcr@ttriangle[5]{%
  \pgfmathsetmacro\dcr@Bx{#2-\dcr@thalf*(#4)}%  middle of the base
  \pgfmathsetmacro\dcr@By{#3-\dcr@thalf*(#5)}%
  \pgfmathsetmacro\dcr@Tx{#2+\dcr@thalf*(#4)}%  tip
  \pgfmathsetmacro\dcr@Ty{#3+\dcr@thalf*(#5)}%
  \pgfmathsetmacro\dcr@Ax{\dcr@Bx-\dcr@twhalf*(#5)}%
  \pgfmathsetmacro\dcr@Ay{\dcr@By+\dcr@twhalf*(#4)}%
  \pgfmathsetmacro\dcr@Cx{\dcr@Bx+\dcr@twhalf*(#5)}%
  \pgfmathsetmacro\dcr@Cy{\dcr@By-\dcr@twhalf*(#4)}%
  \ifdcr@hollow
    \filldraw[#1, fill=white, line width=0.06\dcr@csize, line join=miter]
      (\dcr@Ax pt,\dcr@Ay pt) -- (\dcr@Tx pt,\dcr@Ty pt) -- (\dcr@Cx pt,\dcr@Cy pt) -- cycle;
    % the "!" at the centroid, upright
    \pgfmathsetmacro\dcr@Gx{\dcr@Bx+0.667*\dcr@thalf*(#4)}%
    \pgfmathsetmacro\dcr@Gy{\dcr@By+0.667*\dcr@thalf*(#5)}%
    \fill[#1] ([shift={(-0.04\dcr@csize,-0.02\dcr@csize)}]\dcr@Gx pt,\dcr@Gy pt)
      rectangle ([shift={(0.04\dcr@csize,0.17\dcr@csize)}]\dcr@Gx pt,\dcr@Gy pt)
      ([shift={(-0.04\dcr@csize,-0.17\dcr@csize)}]\dcr@Gx pt,\dcr@Gy pt)
      rectangle ([shift={(0.04\dcr@csize,-0.09\dcr@csize)}]\dcr@Gx pt,\dcr@Gy pt);
  \else
    \fill[#1]
      (\dcr@Ax pt,\dcr@Ay pt) -- (\dcr@Tx pt,\dcr@Ty pt) -- (\dcr@Cx pt,\dcr@Cy pt) -- cycle;
  \fi}

% sizes, and which triangle; #1 relation style
\newcommand\dcr@tsetup[1]{%
  \setlength\dcr@thalf{0.3\dcr@csize}%
  \setlength\dcr@twhalf{0.38\dcr@csize}%
  \setlength\dcr@tchalf{0.5\dcr@csize}%
  \def\dcr@tmp{#1}\def\dcr@tmpb{dcr/milestone}%
  \ifx\dcr@tmp\dcr@tmpb\dcr@hollowtrue\else\dcr@hollowfalse\fi
  \pgfkeysifdefined{/tikz/#1 coopis marker/.@cmd}%
    {\def\dcr@tstyle{#1 coopis marker}}{\def\dcr@tstyle{dcr/coopis marker}}}

\newcommand\dcr@coopisrelation[4]{% #1 line style, #2 options, #3 from, #4 to
  \dcr@tsetup{#1}%
  \ifx\dcr@from\dcr@to
    \dcr@coopisself{#1}{#3}%
  \else
    \dcr@geometry{#2}{#3}{#4}%
    % ---- source triangle ----
    \pgfcoordinate{dcr@b}{\pgfpointanchor{dcr@s}{center}}%
    \pgfcoordinate{dcr@a}{\pgfpointanchor{dcr@s2}{center}}%
    \dcr@computeend{#3}{\dcr@thalf}%
    \let\dcr@lux\dcr@ux \let\dcr@luy\dcr@uy   % direction of the line here
    % The triangle sits square on the side of the box the line leaves
    % through (base on the side, pointing straight out), whatever the angle
    % of the line, as in DCR-js.
    \ifdim\dcr@sx pt>\dcr@sy pt   % left or right side
      \pgfmathsetmacro\dcr@sux{\dcr@bx>\dcr@cx ? 1 : -1}\def\dcr@suy{0}%
    \else                         % top or bottom side
      \def\dcr@sux{0}\pgfmathsetmacro\dcr@suy{\dcr@by>\dcr@cy ? 1 : -1}%
    \fi
    \pgfmathsetmacro\dcr@spx{\dcr@bx+(\dcr@thalf+0.5*\dcr@border)*\dcr@sux}%
    \pgfmathsetmacro\dcr@spy{\dcr@by+(\dcr@thalf+0.5*\dcr@border)*\dcr@suy}%
    \pgfmathsetmacro\dcr@tpx{\dcr@spx+\dcr@thalf*\dcr@sux}%   the tip
    \pgfmathsetmacro\dcr@tpy{\dcr@spy+\dcr@thalf*\dcr@suy}%
    \ifdim\dcr@tbend>0pt
      % dcr/coopis bend: the line leaves the tip straight out and turns
      % into its own direction with a round bend of that radius (at most
      % 30% of a straight line); it starts inside the triangle (dcr@tb)
      \pgfmathsetmacro\dcr@ta{\dcr@tbend}%
      \ifdcr@auto
        \pgfpointanchor{dcr@e}{center}%
        \pgfmathsetmacro\dcr@ta{min(\dcr@ta,0.3*veclen(\pgf@x-\dcr@tpx,\pgf@y-\dcr@tpy))}%
      \fi
      \coordinate (dcr@ta) at
        (\dcr@tpx pt+\dcr@ta*\dcr@sux pt,\dcr@tpy pt+\dcr@ta*\dcr@suy pt);
      \coordinate (dcr@tb) at
        (\dcr@tpx pt-0.6*\dcr@thalf*\dcr@sux,\dcr@tpy pt-0.6*\dcr@thalf*\dcr@suy);
    \else
      % Default: a straight line; its start (dcr@tb) depends on its angle.
      % The line is moved sideways (to the side it turns to) by half its
      % width, so that its edge runs exactly through the tip: the tip
      % touches the line, no gap, nothing sticks out. It starts behind the
      % tip, as far back as the angle allows while its end stays hidden in
      % the triangle (on the axis if the angle permits). At small angles the
      % line is centred on the tip.
      \ifdcr@auto   % straight line: its direction from the tip to the target
        \pgfpointanchor{dcr@e}{center}%
        \pgfmathsetmacro\dcr@lux{\pgf@x-\dcr@tpx}%
        \pgfmathsetmacro\dcr@luy{\pgf@y-\dcr@tpy}%
        \pgfmathsetmacro\dcr@l{max(veclen(\dcr@lux,\dcr@luy),0.001)}%
        \pgfmathsetmacro\dcr@lux{\dcr@lux/\dcr@l}%
        \pgfmathsetmacro\dcr@luy{\dcr@luy/\dcr@l}%
      \fi
      % signed sine and cosine of the angle between the line and the axis
      \pgfmathsetmacro\dcr@lsin{\dcr@sux*\dcr@luy-\dcr@suy*\dcr@lux}%
      \pgfmathsetmacro\dcr@lcos{max(\dcr@sux*\dcr@lux+\dcr@suy*\dcr@luy,0)}%
      \pgfmathsetmacro\dcr@lh{0.5*\dcr@rwidth*min(1,5*abs(\dcr@lsin))*(\dcr@lsin<0 ? -1 : 1)}%
      \pgfmathsetmacro\dcr@lk{min(0.5*\dcr@rwidth*\dcr@lcos/max(abs(\dcr@lsin),0.01),1.6*\dcr@thalf)}%
      % start = tip + lh * (normal of the line) - lk * (direction)
      \coordinate (dcr@tb) at
        (\dcr@tpx pt-\dcr@lh*\dcr@luy pt-\dcr@lk*\dcr@lux pt,
         \dcr@tpy pt+\dcr@lh*\dcr@lux pt-\dcr@lk*\dcr@luy pt);
      \coordinate (dcr@ta) at (dcr@tb);
    \fi
    % ---- target circle ----
    \pgfcoordinate{dcr@b}{\pgfpointanchor{dcr@e}{center}}%
    \ifdcr@auto   % straight line: the circle on the line
      \pgfcoordinate{dcr@a}{\pgfpointanchor{dcr@ta}{center}}%
    \else
      \pgfcoordinate{dcr@a}{\pgfpointanchor{dcr@e2}{center}}%
    \fi
    \dcr@computeend{#4}{\dcr@tchalf}%
    \setlength\dcr@tend{\dimexpr\dcr@t+\dcr@tchalf\relax}%
    % ---- the line, then the markers on top ----
    \ifdcr@routed   % routes leave the box straight; start in the triangle
      \coordinate (dcr@p0) at (dcr@tb);
      \draw[#1, dcr/coopis line, #2, shorten >=\dcr@tend] \dcr@ppath;
    \else\ifdim\dcr@tbend>0pt
      \ifdcr@auto
        \draw[#1, dcr/coopis line, rounded corners=\dcr@ta pt, shorten >=\dcr@tend]
          (dcr@tb) -- (dcr@ta) -- (dcr@e);
      \else\if\relax\detokenize{#2}\relax   % anchors given, no options
        \draw[#1, dcr/coopis line, rounded corners=\dcr@ta pt, shorten >=\dcr@tend]
          (dcr@tb) -- (dcr@ta) -- (#4);
      \else   % own path options (bend ...): a curve that leaves the tip
        % straight out and arrives at the target like the original path
        \coordinate (dcr@tt) at (\dcr@tpx pt,\dcr@tpy pt);
        \pgfmathsetmacro\dcr@oang{atan2(\dcr@suy,\dcr@sux)}%
        \pgfpointdiff{\pgfpointanchor{dcr@e}{center}}{\pgfpointanchor{dcr@e2}{center}}%
        \pgfmathsetmacro\dcr@iang{atan2(\pgf@y,\pgf@x)}%
        \draw[#1, dcr/coopis line, #2, shorten >=\dcr@tend]
          (dcr@tb) -- (dcr@tt) to[relative=false, out=\dcr@oang, in=\dcr@iang] (dcr@e);
      \fi\fi
    \else
      \ifdcr@auto
        \draw[#1, dcr/coopis line, shorten >=\dcr@tend] (dcr@tb) -- (dcr@e);
      \else
        \draw[#1, dcr/coopis line, #2, shorten >=\dcr@tend] (dcr@tb) to (#4);
      \fi
    \fi\fi
    \dcr@ttriangle{#1}{\dcr@spx}{\dcr@spy}{\dcr@sux}{\dcr@suy}%
    \node[\dcr@tstyle] at (\dcr@px pt,\dcr@py pt) {};
    \dcr@decorate{#1}{\dcr@tchalf}%
    \dcr@guardlabel{#1}{#2}{#3}{#4}%
  \fi}

% Self-relations: as in the dcr-solutions notation, only the target circle
% with the symbol, flush on the top edge; several lined up from the left
% corner, or at selfpos= (user: the DCR-js loop round a corner took too
% much room and got in the way of other lines). Values as text above it.
\newcommand\dcr@coopisself[2]{% #1 style, #2 node
  \dcr@portalself{\dcr@tstyle}{#2}{#1}{\dcr@tchalf}}

% The relations, each defined once here:
%   \dcr@defrelation{name}{style}{marker size}{side}{classic source}%
%     {classic target}{classic symbol}
% defines \dcr@<name>[options]{from}{to} (\<name> inside dcrgraph) and the
% inline symbol \dcr<name>[options] (see below).
%   style        the style of the line; "<style> marker" is its
%                dcr-solutions marker (coopis23: "<style> coopis marker")
%   marker size  of that marker (\dcr@csize or \dcr@rsize)
%   side         where the dcr-solutions marker sits: \dcr@atsourcetrue or
%                \dcr@atsourcefalse (the target)
%   classic ...  \dcr@csrc, \dcr@ctgt, \dcr@csym (see Classic notation)
% Direction: every relation is written \relation{from}{to}. The marker is
% at the TARGET for condition, milestone and pre-condition (the activity
% that is blocked), at the SOURCE for all others (the activity that acts),
% as in the DCR portal.
\def\dcr@relnames{}   % the names, for the dcrgraph environment
\newcommand\dcr@defrelation[7]{%
  \expandafter\def\csname dcr@style@#1\endcsname{#2}%
  \expandafter\def\csname dcr@#1@draw\endcsname##1##2##3{%
    \begingroup
      #4\def\dcr@csrc{#5}\def\dcr@ctgt{#6}\def\dcr@csym{#7}%
      \dcr@relation{#2}{#2 marker}{0.5#3}{##1}{##2}{##3}%
    \endgroup}%
  \expandafter\newcommand\csname dcr@#1\endcsname[3][]{%
    \csname dcr@#1@draw\endcsname{##1}{##2}{##3}}%
  \expandafter\NewDocumentCommand\csname dcr#1\endcsname{O{}}%
    {\dcr@inline{#1}{##1}}%
  \edef\dcr@relnames{\dcr@relnames#1,}}

%                 name            style                 marker size   side
%                 classic: source  target   symbol
\dcr@defrelation{condition}      {dcr/condition}       {\dcr@csize}{\dcr@atsourcefalse}
                {}  {dot}    {}
\dcr@defrelation{response}       {dcr/response}        {\dcr@rsize}{\dcr@atsourcetrue}
                {dot}{}      {}
\dcr@defrelation{include}        {dcr/include}         {\dcr@rsize}{\dcr@atsourcetrue}
                {}  {sym}    {+}
\dcr@defrelation{exclude}        {dcr/exclude}         {\dcr@rsize}{\dcr@atsourcetrue}
                {}  {sym}    {\%}
\dcr@defrelation{milestone}      {dcr/milestone}       {\dcr@csize}{\dcr@atsourcefalse}
                {}  {diamond}{}
\dcr@defrelation{update}         {dcr/update}          {\dcr@rsize}{\dcr@atsourcetrue}
                {}  {sym}    {=}
\dcr@defrelation{noresponse}     {dcr/noresponse}      {\dcr@rsize}{\dcr@atsourcetrue}
                {dot}{sym}   {$\times$}
\dcr@defrelation{precondition}   {dcr/precondition}    {\dcr@csize}{\dcr@atsourcefalse}
                {}  {diamond}{}
\dcr@defrelation{spawn}          {dcr/spawn}           {\dcr@rsize}{\dcr@atsourcetrue}
                {}  {sym}    {\Large$\ast$}
% logical include: classic an include arrow with "±" after the arrowhead
% (->±), coopis23 "±" in the circle. The literature has no standard
% symbol for it; this one is used in recent papers (user's choice). One
% relation with one guard, in all notations.
\dcr@defrelation{logicalinclude} {dcr/logical include} {\dcr@rsize}{\dcr@atsourcetrue}
                {}  {sym}    {\textpm}

% Classic notation has no pre-condition: it is what it means, a condition
% plus a milestone. Time and guard on the condition only; with a route,
% the two lines run side by side.
\renewcommand\dcr@precondition[3][]{%
  \ifdcr@classic
    \dcr@condition[#1,dcr@shift=0.5\dcr@pardist]{#2}{#3}%
    \dcr@milestone[#1,dcr@nodelay,dcr@noguard,dcr@shift=-0.5\dcr@pardist]{#2}{#3}%
  \else
    \dcr@precondition@draw{#1}{#2}{#3}%
  \fi}

% (no longer used by the package; kept for documents that use it)
\newcommand\dcrnotguard[1]{not(#1)}

% ------------------------------------------------------------------
%  Nesting:  \nesting[options]{label}{id}{child1, child2, ...}
%
%  A box drawn around the children (activities or other nestings), with
%  the label at the top and an "n" in the lower right corner. It is a
%  normal node, so relations can start or end at it.
%  With area={(x1,y1)(x2,y2)} the box is exactly that rectangle instead
%  (used by \includedcrgraph to keep the size from the file).
%
%  Nestings are drawn behind activities on their own layers. Each nesting
%  remembers its depth (1 + deepest child), and deeper = further back,
%  so an outer nesting never covers an inner one.
% ------------------------------------------------------------------
\def\dcr@maxdepth{6}
\pgfdeclarelayer{dcrnest1}\pgfdeclarelayer{dcrnest2}\pgfdeclarelayer{dcrnest3}
\pgfdeclarelayer{dcrnest4}\pgfdeclarelayer{dcrnest5}\pgfdeclarelayer{dcrnest6}

\newcount\dcr@depth
% \nesting[options]{label}{id}{children}     : "n" in the corner
% \subprocess[options]{label}{id}{children}  : "s" in the corner
% \form[options]{label}{id}{children}        : "f" in the corner
\newcommand\dcr@nesting[4][]{\dcr@group{n}{#1}{#2}{#3}{#4}}
\newcommand\dcr@subprocess[4][]{\dcr@group{s}{#1}{#2}{#3}{#4}}
\newcommand\dcr@form[4][]{\dcr@group{f}{#1}{#2}{#3}{#4}}
% \subgraph[options]{label}{id}{children}    : a subgraph (template) with
%   its own events, target of spawns: dotted, "|||" and "g" (DCR portal)
\newcommand\dcr@subgraphgroup[4][]{\dcr@group{g}{subgraph,#1}{#2}{#3}{#4}}
\newif\ifdcr@withheader \newif\ifdcr@noheader
\newcommand\dcr@group[5]{% #1 corner letter, #2 options, #3 label, #4 id, #5 children
  \begingroup
    \def\dcr@role{}\def\dcr@subtitle{}\def\dcr@bg{}\def\dcr@tikzopts{}\def\dcr@area{}%
    \def\dcr@bc{dcr border}\def\dcr@tc{dcr text}%
    \dcr@resetflags
    \pgfkeys{/dcr@act,#2}%
    % children -> "(A)(B)(C)" for fit, and the depth of this nesting
    \edef\dcr@list{\zap@space#5 \@empty}%
    \def\dcr@fit{}\dcr@depth=0
    \@for\dcr@c:=\dcr@list\do{%
      \edef\dcr@fit{\dcr@fit(\dcr@c)}%
      \ifcsname dcr@depth@\the\dcr@graph @\dcr@c\endcsname
        \ifnum\csname dcr@depth@\the\dcr@graph @\dcr@c\endcsname>\dcr@depth
          \dcr@depth=\csname dcr@depth@\the\dcr@graph @\dcr@c\endcsname\relax
        \fi
      \fi}%
    \advance\dcr@depth 1
    \ifnum\dcr@depth>\dcr@maxdepth
      \PackageWarning{dcrgraph}{Nesting `#4' is deeper than
        \dcr@maxdepth\space levels; it may be drawn over an inner nesting}%
      \dcr@depth=\dcr@maxdepth\relax
    \fi
    \expandafter\xdef\csname dcr@depth@\the\dcr@graph @#4\endcsname{\the\dcr@depth}%
    \begin{pgfonlayer}{dcrnest\the\dcr@depth}
      % 1) the area around the children (invisible), with the normal padding,
      %    or exactly the given area={(x1,y1)(x2,y2)}
      \ifx\dcr@area\@empty
        \edef\dcr@do{\noexpand\path node[dcr/nesting, draw=none, fill=none,
          fit={\dcr@fit}, \unexpanded\expandafter{\dcr@tikzopts}] (#4@box)}%
      \else
        \edef\dcr@do{\noexpand\path node[dcr/nesting, draw=none, fill=none,
          inner sep=0pt, outer sep=0pt, fit={\unexpanded\expandafter{\dcr@area}},
          \unexpanded\expandafter{\dcr@tikzopts}] (#4@box)}%
      \fi
      \dcr@do {};
      \pgftransformreset   % the rest relative to that box, see \dcr@activity
      % 2) the visible box: extra room on top for a role header, and at
      %    the bottom for a subtitle (not with area=, which is exact)
      % a header line: with a role, and always for forms (as in the portal)
      \dcr@withheaderfalse
      \ifx\dcr@role\@empty\else\dcr@withheadertrue\fi
      \def\dcr@tmp{#1}\def\dcr@tmpb{f}\ifx\dcr@tmp\dcr@tmpb\dcr@withheadertrue\fi
      \ifdcr@withheader\dcr@noheaderfalse\else\dcr@noheadertrue\fi
      \dimen@=0pt \dimen2=0pt
      \ifx\dcr@area\@empty
        \ifdcr@withheader\dimen@=\dcr@header\fi
        \ifx\dcr@subtitle\@empty\else\dimen2=0.35cm\fi
        % room for the label above the children (the padding alone is just
        % the label's height: it touched the headers of the events), and
        % below it for the marker of a self-relation on the top edge of an
        % event (0.36cm)
        \if\relax\detokenize{#3}\relax\else
          \ifx\dcr@list\@empty\else\advance\dimen@ by 0.4cm\fi
        \fi
      \fi
      \edef\dcr@do{\noexpand\node[dcr/nesting, inner sep=0pt,
        fit={(#4@box.north west)(#4@box.south east)
             ([yshift=\the\dimen@]#4@box.north)([yshift=-\the\dimen2]#4@box.south)},
        draw=\dcr@bc,
        \ifx\dcr@bg\@empty\else fill=\dcr@bg,\fi
        \ifdcr@subgraph dcr/subgraph,\fi
        \ifdcr@excluded dcr/excluded,\fi] (#4)}%
      \dcr@do {};
      \ifdcr@noheader
        \if\relax\detokenize{#3}\relax\else
          \ifx\dcr@list\@empty   % no children: label in the middle, like an event
            \node[dcr/label, text=\dcr@tc] at (#4.center) {#3};
          \else
            \node[dcr/nesting label, text=\dcr@tc, anchor=north]
              at ([yshift=-2pt]#4.north) {#3};
          \fi
        \fi
      \else
        % header like an activity: role on top, label just below the line
        % (with a role, and always for forms, as in the DCR portal)
        \draw[draw=\dcr@bc, line width=\dcr@border,
              \ifdcr@excluded dcr/excluded\fi]
          ([yshift=-\dcr@header]#4.north west) -- ([yshift=-\dcr@header]#4.north east);
        \ifx\dcr@role\@empty\else
          \node[dcr/role, text=\dcr@tc] at ([yshift=-0.5\dcr@header]#4.north) {\dcr@role};
        \fi
        \if\relax\detokenize{#3}\relax\else
          \node[dcr/nesting label, text=\dcr@tc, anchor=north]
            at ([yshift=-\dcr@header-2pt]#4.north) {#3};
        \fi
      \fi
      \ifx\dcr@subtitle\@empty\else
        \node[anchor=south, inner sep=0pt, font=\dcr@font\dcr@subfont,
              text=dcr subtitle] at ([yshift=4pt]#4.south) {\dcr@subtitle};
      \fi
      \ifdcr@subgraph  % subgraph: "|||" at the bottom centre and the "g"
        \draw[dcr/subgraph collection bars] \foreach \dcr@x in {-2.5pt,0pt,2.5pt}
          {([xshift=\dcr@x,yshift=4pt]#4.south) -- ++(0,7pt)};
        \node[dcr/nesting marker, anchor=south east]
          at ([xshift=-3pt,yshift=1pt]#4.south east) {#1};
      \else
        \node[dcr/nesting marker, anchor=south east]
          at ([xshift=-3pt,yshift=1pt]#4.south east) {#1};
      \fi
      % marking, top left, as for events (below the header, if any)
      \ifdcr@withheader\dimen@=\dcr@header\else\dimen@=0pt\fi
      \dcr@marking{#4}{\dimen@}%
    \end{pgfonlayer}
  \endgroup
}

\providecommand\checkmark{\ensuremath{\surd}}

% Size of the whole graph, for a graph or (\dcrset) a document:
%   width=, height=        exactly this size (both: as large as fits in
%                          both, the aspect ratio is kept)
%   max width=, max height= at most this size: only shrinks
% The graph is scaled as a whole, text and markers included (like
% \resizebox). The picture is typeset into a box, measured and scaled at
% the end of the environment.
\def\dcr@w{}\def\dcr@h{}\def\dcr@maxw{}\def\dcr@maxh{}
\tikzset{
  dcr/width/.code={\def\dcr@w{#1}},
  dcr/height/.code={\def\dcr@h{#1}},
  dcr/max width/.code={\def\dcr@maxw{#1}},
  dcr/max height/.code={\def\dcr@maxh{#1}},
}
\newsavebox\dcr@gbox
\ExplSyntaxOn
\fp_new:N \l__dcr_scale_fp
% #1 limit (a length or empty), #2 the size of the box in that direction:
% the scale factor becomes at most #1 / #2
\cs_new_protected:Npn \__dcr_limit:nn #1#2
  {
    \tl_if_blank:nF {#1}
      {
        \dim_compare:nNnT {#2} > { 0pt }
          {
            \fp_set:Nn \l__dcr_scale_fp
              { min ( \l__dcr_scale_fp , \dim_to_fp:n {#1} / \dim_to_fp:n {#2} ) }
          }
      }
  }
\cs_generate_variant:Nn \__dcr_limit:nn { V }
% the graph in \dcr@gbox, scaled to the sizes in \dcr@g@w etc.
\cs_new_protected:Npn \dcr@placegraph
  {
    \bool_lazy_all:nTF
      {
        { \tl_if_blank_p:V \dcr@g@w } { \tl_if_blank_p:V \dcr@g@h }
        { \tl_if_blank_p:V \dcr@g@maxw } { \tl_if_blank_p:V \dcr@g@maxh }
      }
      { \usebox \dcr@gbox }
      {
        % exact size: the smaller factor of width= and height=; none: 1
        \fp_set_eq:NN \l__dcr_scale_fp \c_inf_fp
        \__dcr_limit:Vn \dcr@g@w { \box_wd:N \dcr@gbox }
        \__dcr_limit:Vn \dcr@g@h { \box_ht_plus_dp:N \dcr@gbox }
        \fp_compare:nNnT \l__dcr_scale_fp = \c_inf_fp
          { \fp_set:Nn \l__dcr_scale_fp { 1 } }
        % at most: only shrink
        \__dcr_limit:Vn \dcr@g@maxw { \box_wd:N \dcr@gbox }
        \__dcr_limit:Vn \dcr@g@maxh { \box_ht_plus_dp:N \dcr@gbox }
        \scalebox { \fp_use:N \l__dcr_scale_fp } { \usebox \dcr@gbox }
      }
  }
\ExplSyntaxOff

\def\dcr@begintikz#1{\begin{tikzpicture}[#1]}
\newenvironment{dcrgraph}[1][]{%
  % the commands, only inside dcrgraph (so \include works as usual in
  % the rest of the document)
  \let\activity\dcr@activity
  \let\nesting\dcr@nesting
  \let\subprocess\dcr@subprocess
  \let\form\dcr@form
  \let\subgraph\dcr@subgraphgroup
  \@for\dcr@r:=\dcr@relnames\do{\ifx\dcr@r\@empty\else
    \expandafter\let\csname\dcr@r\expandafter\endcsname
      \csname dcr@\dcr@r\endcsname\fi}%
  \global\advance\dcr@graph 1
  \pgfsetlayers{dcrnest6,dcrnest5,dcrnest4,dcrnest3,dcrnest2,dcrnest1,main}%
  \dcr@mapopts{#1}%   settings without dcr/, see \dcrset
  % into a box (as lrbox does), scaled at the end: see width= etc.
  \setbox\dcr@gbox\hbox\bgroup\color@setgroup
  \expandafter\dcr@begintikz\expandafter{\dcr@opts}%
}{%
    % the sizes set in the options, out of the picture's group
    \global\let\dcr@g@w\dcr@w \global\let\dcr@g@h\dcr@h
    \global\let\dcr@g@maxw\dcr@maxw \global\let\dcr@g@maxh\dcr@maxh
  \end{tikzpicture}%
  \color@endgroup\egroup
  \dcr@placegraph
}

% ------------------------------------------------------------------
%  Relation symbols for running text and formulas:
%     A \dcrcondition B,  $A \dcrlogicalinclude[guard={x > 5}] B$
%  One command per relation, \dcr<relation>[options]; usable in text and
%  in math (spaced as a relation). Each symbol is a small picture with the
%  relation drawn by the same code as in a graph, from a point to a point
%  -- so it looks as in the graphs, in the current notation.
%  Like \xrightarrow: the guard is written above the line, the time
%  (delay of a condition, deadline of a response) below it, both close to
%  the line and centred; the line grows to fit them.
%  Options:
%    guard=expr          the guard, above the line
%    delay=P7D           delay of a condition / pre-condition, below the
%                        line (dcr-solutions: and the clock marker)
%    deadline=P5D        deadline of a response, the same
%    notation=classic    notation of this symbol (default: as the document)
%    length=2em          shortest length of the line (default 1.8em)
%    other options: as for a relation in a graph (TikZ options, ...)
%  Sizes: the style dcr/inline (\dcrset{inline/.append style={...}}); in
%  em, so the symbols follow the font size. dcr/inline label distance:
%  between the line and the guard / time.
% ------------------------------------------------------------------
\def\dcr@isep{0.12em}
\def\dcr@iclear{1.1em}   % room for the markers at each end of the line
                         % (classic: arrow tip and symbol, about 1.05em)
\tikzset{
  dcr/inline/.style={dcr/marker size=0.8em, dcr/relation width=0.06em,
    dcr/classic marker size=0.45em, dcr/border width=0pt,
    dcr/parallel distance=0.75em,
    dcr/classic tip/.style={-{Triangle[length=0.55em,width=0.5em]}}},
  dcr/inline label distance/.code={\def\dcr@isep{#1}},
  % values: 0.7 of the size of the symbol (\dcr@ilabelsize), so they shrink
  % with it in sub- and superscripts
  dcr/inline guard/.style={font=\dcr@font\dcr@ilabelsize, inner sep=0pt},
  dcr/inline time/.style={dcr/delay label, font=\dcr@font\bfseries\dcr@ilabelsize,
    inner sep=0pt},
}
\pgfkeys{
  /dcr@inl/.is family, /dcr@inl,
  notation/.code={\tikzset{dcr/notation=#1}},
  length/.store in=\dcr@ilen,
  guard/.store in=\dcr@ig,
  guard/.default={},
  % the time (delay of a condition, deadline of a response): written here,
  % and given to the relation (clock marker in dcr-solutions; and the
  % relation checks that it may have this time)
  delay/.code={\def\dcr@idelay{#1}%
    \edef\dcr@iopts{\unexpanded\expandafter{\dcr@iopts}delay={\unexpanded{#1}},}},
  deadline/.code={\def\dcr@idelay{#1}%
    \edef\dcr@iopts{\unexpanded\expandafter{\dcr@iopts}deadline={\unexpanded{#1}},}},
  explicit/.code={},   % inline, the values are always written
  % everything else: options of the relation
  .unknown/.code={\dcr@passon\dcr@iopts{#1}},
}
% #1 relation (condition, response, ...), #2 options.
% A relation symbol, exactly like \rightarrow: in math \mathrel (TeX does
% the spacing, its stretching, line breaks after it), and \mathpalette:
% drawn for the math style it is in, so it shrinks in sub- and
% superscripts. In text as $\rightarrow$ between two words: a formula with
% only the symbol, word spaces around it. The space after the command is
% swallowed by TeX, so it is put back (as the xspace package does), except
% before punctuation, closing brackets, an explicit space or {}.
\newcommand\dcr@inline[2]{%
  \ifmmode
    \mathrel{\mathpalette\dcr@inlinestyle{{#1}{#2}}}%
  \else
    $\m@th\mathrel{\mathpalette\dcr@inlinestyle{{#1}{#2}}}$%
    \expandafter\dcr@xspace
  \fi}
\def\dcr@xspace{\futurelet\dcr@next\dcr@xspace@}
\def\dcr@xspace@{%
  \let\dcr@do\space
  \@tfor\dcr@tok:=,.;:!?)]'/-~\ \/\bgroup\egroup\@xobeysp\footnote
    \do{\expandafter\ifx\dcr@tok\dcr@next\let\dcr@do\relax\fi}%
  \dcr@do}
% #1 math style, #2 {relation}{options}
\def\dcr@inlinestyle#1#2{\dcr@inlinebox#1#2}
% #1 math style, #2 relation, #3 options
\newcommand\dcr@inlinebox[3]{%
  \hbox{\begingroup
    % the size of the math style (as \rightarrow would be): text and
    % display the current size, script \sf@size, scriptscript \ssf@size;
    % the font for the math axis of that style
    \let\dcr@iaxisfont\textfont
    \ifx#1\scriptstyle
      \let\dcr@iaxisfont\scriptfont\fontsize\sf@size\z@\selectfont
    \else\ifx#1\scriptscriptstyle
      \let\dcr@iaxisfont\scriptscriptfont\fontsize\ssf@size\z@\selectfont
    \fi\fi
    \dimen@=\f@size pt\dimen@=0.7\dimen@
    \edef\dcr@ilabelsize{\noexpand\fontsize{\strip@pt\dimen@}{\z@}%
      \noexpand\selectfont}%
    % a number of its own (negative, so it never clashes with a graph):
    % the graphs' numbers name their totals in the .aux, and must not
    % depend on how many symbols come before them (\mathpalette draws each
    % symbol four times, a table of contents adds more in the next run)
    \global\advance\dcr@isym 1
    \dcr@graph=-\dcr@isym
    \dcr@inlinesymtrue
    \def\dcr@ilen{1.8em}\def\dcr@iopts{}\def\dcr@ig{}\def\dcr@idelay{}%
    \tikzset{dcr/inline}%
    \pgfkeys{/dcr@inl,#3}%
    % the relation itself writes no values (they are written below);
    % dcr-solutions keeps the clock marker of a time
    \tikzset{dcr/guards=none}%
    \ifdcr@classic\tikzset{dcr/delays=none, dcr/deadlines=none}%
    \else\tikzset{dcr/delays=marker, dcr/deadlines=marker}\fi
    % classic/coopis23 draw a pre-condition as two relations, stacked
    % (condition on top)
    \def\dcr@itotal{1}%
    \def\dcr@tmp{#2}%
    \ifdcr@classic
      \def\dcr@tmpb{precondition}\ifx\dcr@tmp\dcr@tmpb\def\dcr@itotal{2}\fi
    \fi
    % colour of the guard: that of the relation; of the time: as in a graph
    \edef\dcr@istyle{\csname dcr@style@#2\endcsname}%
    \expandafter\dcr@thisdelaylabel\expandafter{\dcr@istyle}%
    % the length: at least \dcr@ilen, else the widest value and room for
    % the markers at both ends (so the values are over/under the line)
    \dimen@=0pt
    \ifx\dcr@ig\@empty\else
      \setbox\z@\hbox{\dcr@font\dcr@ilabelsize\dcrguardformat{\dcr@ig}}%
      \ifdim\wd\z@>\dimen@\dimen@=\wd\z@\fi
    \fi
    \ifx\dcr@idelay\@empty\else
      \setbox\z@\hbox{\dcr@font\bfseries\dcr@ilabelsize\dcr@idelay}%
      \ifdim\wd\z@>\dimen@\dimen@=\wd\z@\fi
    \fi
    \ifdim\dimen@>0pt \advance\dimen@ by 2\dimexpr\dcr@iclear\relax\fi
    \dimen@ii=\dcr@ilen\relax
    \ifdim\dimen@>\dimen@ii\dimen@ii=\dimen@\fi
    \edef\dcr@iL{\the\dimen@ii}%
    % how far the values are from the axis: the line (half its width),
    % the upper / lower of two stacked lines, and the distance
    \dimen@=\dcr@isep\relax
    \advance\dimen@ by 0.5\dcr@rwidth
    \ifnum\dcr@itotal=2 \advance\dimen@ by 0.5\dcr@pardist\fi
    \edef\dcr@ioff{\the\dimen@}%
    \edef\dcr@do{\noexpand\csname dcr@#2\endcsname
      [\unexpanded\expandafter{\dcr@iopts}]{dcr@ia}{dcr@ib}}%
    % The line on the math axis (the height of the middle of a "+"). The
    % ends are small boxes, left out of the size of the symbol (overlay):
    % not empty ones, as the markers are placed by the side of the box the
    % line hits, and tall enough for two stacked lines.
    \begin{tikzpicture}[baseline={(0pt,-\the\fontdimen22\dcr@iaxisfont2)},
        dcr@iend/.style={inner sep=0pt, outer sep=0pt, minimum width=0.5pt,
          minimum height=2em}]
      \path[overlay] (0,0) node[dcr@iend] (dcr@ia) {}
        (\dcr@iL,0) node[dcr@iend] (dcr@ib) {};
      \dcr@do
      \ifx\dcr@ig\@empty\else
        \node[\dcr@istyle, dcr/inline guard, anchor=south]
          at (0.5*\dcr@iL,\dcr@ioff) {\dcrguardformat{\dcr@ig}};
      \fi
      \ifx\dcr@idelay\@empty\else
        \node[dcr/inline time, dcr/this delay label, anchor=north]
          at (0.5*\dcr@iL,-\dcr@ioff) {\dcr@idelay};
      \fi
      % the size of the symbol: exactly as wide as the line (no room for
      % the helper points of the relation), as high as what is drawn
      \edef\dcr@do{\noexpand\pgfresetboundingbox
        \noexpand\path[use as bounding box]
          (0pt,\the\pgf@picminy) rectangle (\dcr@iL,\the\pgf@picmaxy);}%
      \dcr@do
    \end{tikzpicture}%
  \endgroup}}
% (the commands \dcrcondition etc. are defined with the relations, see
% \dcr@defrelation)

% ------------------------------------------------------------------
%  \includedcrgraph[options]{file}  -- draw a graph from a file, converted
%  into dcrgraph commands by the Lua code at the end of this file. Options:
%    format=auto         input format: recognised from the file (DCR Solutions XML
%                        or DCR-js XML); dcrsolutions, dcrjs accepted
%    waypoints           draw relations along the routes stored in the file
%                        (default: straight lines between the boxes)
%    notation=classic    notation (dcr-solutions, classic, coopis23), as for the dcrgraph environment
%    scale=0.8           scale positions (box sizes and text stay the same)
%    width=, height=, max width=, max height=   size of the whole graph,
%                        scaled as a whole (as for the dcrgraph environment)
%    marking=false       leave out executed / pending / excluded
%    By default the graph looks like the DCR portal: guards, delays and
%    deadlines only as markers (shield, clock), no values. To show values:
%    guards=explicit     guard expressions as text [ expr ] (or both)
%    delays=explicit     times of conditions etc. as text
%    deadlines=explicit  times of responses as text
%    explicit            all three
%    guards={A4 response A6, A6 A7}   only for these relations; the same
%    delays={...}, deadlines={...}    for delays and deadlines. Each entry
%                        "source type target" or "source target" (ids from
%                        the file; `value' = \update). Warns about entries
%                        that match no relation or have no such value.
%    export=file.tex     also write the generated code to file.tex (in the
%                        output directory; on Overleaf under "Logs and output
%                        files"), and a copy of it into the .log
%  For now LuaLaTeX only.
% ------------------------------------------------------------------
% The converter is the Lua code at the end of this file (after \endinput,
% so TeX never reads it); under LuaLaTeX it is loaded from there now.
\ifdefined\directlua
  \directlua{
    local dir = "\luaescapestring{\CurrentFilePath}"
    local path = (dir ~= "" and (dir .. "/") or "") .. "dcrgraph.sty"
    local f = io.open(path, "rb")
    if not f then
      path = kpse.find_file("dcrgraph.sty")
      f = path and io.open(path, "rb")
    end
    if f then
      local text = f:read("*a")
      f:close()
      local s = text:find("-- DCRGRAPHS " .. "LUA BEGIN", 1, true)
      if s then
        local _, lines = text:sub(1, s):gsub(string.char(10), "")
        dcrgraphs = load(string.rep(string.char(10), lines) .. text:sub(s),
          "@" .. path)()
      end
    end
  }
\fi
\newwrite\dcr@export   % for export=file.tex
\newcommand\includedcrgraph[2][]{%
  \ifdefined\directlua
    \directlua{
      if dcrgraphs then
        dcrgraphs.include("\luaescapestring{\detokenize{#1}}",
                          "\luaescapestring{\detokenize{#2}}")
      else
        tex.error("dcrgraph: could not load the converter from dcrgraph.sty")
      end}%
  \else
    \PackageError{dcrgraph}{\string\includedcrgraph\space needs LuaLaTeX}%
      {Compile with lualatex (on Overleaf: Menu > Compiler > LuaLaTeX).}%
  \fi}

% ------------------------------------------------------------------
%  An imported graph with manual adjustments:
%    \begin{dcrgraphfile}[options of \includedcrgraph]{file}
%      \adjustactivity{A6}{shift={(1,0)}, bgcolor=red!10}
%      \adjustrelation{A6 include A7}{from=south, to=east, bend left=10}
%    \end{dcrgraphfile}
%  \adjustactivity{id}{options}: shift/xshift/yshift move the box (a
%    collection with everything inside it); other options go to the box.
%  \adjustrelation{relation}{options}: relation as in guards={...}
%    ("source type target" or "source target"); from=/to= an anchor of the
%    box (north, south east, 30, ...) where the line starts/ends; other
%    options go to the relation (bend left=20, via=..., explicit=...).
%  The graph is drawn at \end{dcrgraphfile}.
% ------------------------------------------------------------------
\newcommand\dcr@adjust[3]{% #1 activity|relation, #2 target, #3 options
  \ifdefined\directlua
    \directlua{if dcrgraphs then dcrgraphs.add_adjust("#1",
      "\luaescapestring{\detokenize{#2}}", "\luaescapestring{\detokenize{#3}}") end}%
  \fi\ignorespaces}
\newenvironment{dcrgraphfile}[2][]{%
  \def\dcr@fileopts{#1}\def\dcr@filename{#2}%
  \ifdefined\directlua
    \directlua{if dcrgraphs then dcrgraphs.begin_adjust() end}%
  \fi
  \def\adjustactivity##1##2{\dcr@adjust{activity}{##1}{##2}}%
  \def\adjustrelation##1##2{\dcr@adjust{relation}{##1}{##2}}%
  \ignorespaces
}{%
  \unskip
  \ifdefined\directlua
    \directlua{
      if dcrgraphs then
        dcrgraphs.include(
          "\luaescapestring{\detokenize\expandafter{\dcr@fileopts}}",
          "\luaescapestring{\detokenize\expandafter{\dcr@filename}}",
          dcrgraphs.pending_adjust)
      else
        tex.error("dcrgraph: could not load the converter from dcrgraph.sty")
      end}%
  \else
    \PackageError{dcrgraph}{dcrgraphfile needs LuaLaTeX}%
      {Compile with lualatex (on Overleaf: Menu > Compiler > LuaLaTeX).}%
  \fi}

\endinput
-- DCRGRAPHS LUA BEGIN
-- The converter behind \includedcrgraph: DCR graph files -> dcrgraph code.
-- It lives here, after \endinput, so the package is a single file; the
-- TeX part above loads it under LuaLaTeX. Loaded as one chunk returning
-- the module table.
--
-- Front ends (one per input format) build a common graph model; one
-- emitter writes it as dcrgraph commands.
--
-- On the command line (development): texlua dcrgraph-cli.lua file.xml

local M = {}

-- notations with the relation set of the literature (no pre-condition,
-- values as text): classic and coopis23
local NOTATIONS = { ["dcr-solutions"] = true, classic = true, coopis23 = true }
local function literature_notation(n)
  return n == "classic" or n == "coopis23"
end

-- Pixels per cm, per tool, chosen so that a default box of the tool comes
-- out 2.6cm wide, the width of a default \activity:
--   DCR-js: boxes 130 x 150 px, stored in the file        -> 50 px/cm
--   DCR portal: boxes 115 x 125 px (measured on a portal
--   screenshot; header 20 px), no size in the file        -> 44.2 px/cm,
--   which gives exactly the default \activity (2.6 x 2.8cm)
local PX_PER_CM = { dcrjs = 50, portal = 115 / 2.6 }
local DEFAULT_SIZE = { dcrjs = { 130, 150 }, portal = { 115, 125 } }
-- A subgraph (template) event in the portal is a default box without the
-- header strip: 20 px lower, same bottom edge (measured on a screenshot)
local PORTAL_HEADER = 20
-- A collection (nesting, subprocess, subgraph with events) in the portal:
-- the box around its children's boxes, 30 px on the left, right and top,
-- 50 px at the bottom (for "n", "s", "g", "|||"); measured on a screenshot
local COLLECTION_PAD = { left = 30, right = 30, top = 30, bottom = 50 }
-- the portal's default event colours; they equal the package defaults
-- (dcr activity, dcr border, dcr text), so they need not be emitted
local DEFAULT_COLOR = { bg = "f9f7ed", stroke = "cccccc", textstroke = "000000" }

-- ------------------------------------------------------------------
--  Messages (TeX log when inside LuaLaTeX, stderr on the command line)
-- ------------------------------------------------------------------
local in_tex = false

M.warnings = {}   -- all warnings of the last conversion (for the tests)

local function warn(msg)
  M.warnings[#M.warnings + 1] = msg
  if in_tex then
    texio.write_nl("term and log", "Package dcrgraph Warning: " .. msg)
    texio.write_nl("term and log", "")
  else
    io.stderr:write("dcrgraphs warning: " .. msg .. "\n")
  end
end

local function fail(msg)
  error("dcrgraphs: " .. msg, 0)
end

-- ------------------------------------------------------------------
--  Small DOM helpers (luaxml-domobject). luaxml lowercases attribute
--  names, so names are compared in lower case.
-- ------------------------------------------------------------------
-- element name, lower case, without a namespace prefix ("dcr:event" ->
-- "event"; the DCR-js format uses prefixes, the portal format does not)
local function ename(el)
  return (el:get_element_name():lower():gsub("^.*:", ""))
end

local function attr(el, name)
  return el:get_attribute(name:lower())
end

local function elements(el, name)
  local list = {}
  if not el then return list end
  for _, c in ipairs(el:get_children()) do
    if c:is_element() and (name == nil or ename(c) == name:lower()) then
      list[#list + 1] = c
    end
  end
  return list
end

-- first child element along a path of names, or nil
local function child(el, ...)
  for _, name in ipairs({...}) do
    if not el then return nil end
    el = elements(el, name)[1]
  end
  return el
end

local function num(s)
  return tonumber(s) or 0
end

-- ------------------------------------------------------------------
--  Front end 1: DCR Solutions XML (the DCR portal's format; DCR-js can
--  export it too: "portal export")
--
--  Model:
--    graph.nodes      list, children before parents:
--                     {id, label, roles, x, y, w, h (px, y down),
--                      kind = "activity"|"nesting"|"subprocess",
--                      children = {ids}, executed, pending, excluded,
--                      data, computation, dmn, global (event types),
--                      bg = "RRGGBB" or nil (non-default background)}
--    graph.relations  list: {kind, from, to, waypoints = {{x,y},...},
--                            delay}
-- ------------------------------------------------------------------
local relation_kinds = {
  conditions     = { elem = "condition",     kind = "condition" },
  responses      = { elem = "response",      kind = "response" },
  excludes       = { elem = "exclude",       kind = "exclude" },
  includes       = { elem = "include",       kind = "include" },
  milestones     = { elem = "milestone",     kind = "milestone" },
  updates        = { elem = "update",        kind = "update" },
  coresponses    = { elem = "coresponse",    kind = "noresponse" },
  spawns         = { elem = "spawn",         kind = "spawn" },
  templateSpawns = { elem = "templateSpawn", kind = "spawn" },   -- to a subgraph
}

-- The portal stores two relations as a linked pair (same `link' attribute,
-- same source and target):
--   condition + milestone -> pre-condition
--   include   + exclude   -> logical include
-- Merge them into one relation, at the place of the first of the pair.
local linked_pairs = {
  { "condition", "milestone", "precondition" },
  { "include",   "exclude",   "logicalinclude" },
}
local function merge_linked(rels)
  local drop = {}
  for _, pair in ipairs(linked_pairs) do
    local a, b, merged = pair[1], pair[2], pair[3]
    for _, r in ipairs(rels) do
      if r.kind == a and r.link then
        for j, q in ipairs(rels) do
          if not drop[j] and q.kind == b and q.link == r.link
             and q.from == r.from and q.to == r.to then
            -- keep both halves, for the classic notation (which has no
            -- pre-condition: there it is drawn as the two relations it is
            -- made of)
            local first = {}
            for k, v in pairs(r) do first[k] = v end
            r.parts = { first, q }
            r.kind = merged
            r.delay = r.delay or q.delay
            -- (a logical include keeps the guard of its include: the
            -- exclude half has the negation)
            if merged == "precondition" then r.guard = r.guard or q.guard end
            drop[j] = true
            break
          end
        end
      end
    end
  end
  local kept = {}
  for i, r in ipairs(rels) do if not drop[i] then kept[#kept + 1] = r end end
  return kept
end

local function read_dcrsolutions(dom)
  local root = child(dom:root_node(), "dcrgraph")
  if not root then fail("no <dcrgraph> element found") end
  -- which tool wrote the file: the DCR portal adds a <meta> block
  local tool = child(root, "meta") and "portal" or "dcrjs"
  local graph = { nodes = {}, relations = {}, px_per_cm = PX_PER_CM[tool] }

  -- One <dcrgraph>: its events, relations and marking. A subgraph
  -- (template) event contains a whole <dcrgraph> of its own, read by the
  -- same function. `outer' = labels and expressions of the enclosing graph.
  -- Returns the ids of the top-level events.
  local function read_graph(root, outer)
  local spec = child(root, "specification")
  local res = child(spec, "resources")

  -- labels: <labelMapping eventId=... labelId=...>, the label id is the text
  local labels = setmetatable({}, { __index = outer.labels })
  for _, m in ipairs(elements(child(res, "labelMappings"), "labelMapping")) do
    labels[attr(m, "eventId")] = attr(m, "labelId")
  end

  -- expressions: id -> type (computations; type="DMN" for DMN events)
  -- and id -> value (guards of relations: expressionId)
  local exprtype = setmetatable({}, { __index = outer.exprtype })
  local exprvalue = setmetatable({}, { __index = outer.exprvalue })
  for _, e in ipairs(elements(child(res, "expressions"), "expression")) do
    exprtype[attr(e, "id")] = attr(e, "type") or ""
    exprvalue[attr(e, "id")] = attr(e, "value")
  end

  -- marking
  local function idset(el)
    local s = {}
    for _, e in ipairs(elements(el, "event")) do s[attr(e, "id")] = true end
    return s
  end
  local marking = child(root, "runtime", "marking")
  local executed = idset(child(marking, "executed"))
  local pending = idset(child(marking, "pendingResponses"))
  local included_el = child(marking, "included")
  local included = included_el and idset(included_el)

  -- events, recursively: an event containing events is a nesting
  local function read_event(ev)
    local id = attr(ev, "id")
    local kids = {}
    for _, sub in ipairs(elements(ev, "event")) do
      kids[#kids + 1] = read_event(sub)
    end
    -- a subgraph (template) with its own graph: its events are its children
    local etype = attr(ev, "type")
    -- (<event type="template"><template><dcrgraph>...)
    local inner = etype == "template" and child(ev, "template", "dcrgraph")
    if inner then
      for _, k in ipairs(read_graph(inner, { labels = labels,
          exprtype = exprtype, exprvalue = exprvalue })) do
        kids[#kids + 1] = k
      end
    end
    local custom = child(ev, "custom")
    local roles = {}
    for _, r in ipairs(elements(child(custom, "roles"), "role")) do
      local t = r:get_text()
      if t and t ~= "" then roles[#roles + 1] = t end
    end
    -- receivers (choreographies): the portal's "read roles", all of them
    -- as in the file (the portal shows the sender too, if listed)
    local receivers = {}
    for _, r in ipairs(elements(child(custom, "readRoles"), "readRole")) do
      local t = r:get_text()
      if t and t ~= "" then receivers[#receivers + 1] = t end
    end
    local loc = child(custom, "visualization", "location")
    local size = child(custom, "visualization", "size")
    if not loc then warn("event `" .. id .. "' has no position; placed at (0,0)") end
    -- a form with events is a collection (with a header, "f"); an empty
    -- form is an event with the form key ("f")
    local kind = "activity"
    if etype == "form" then
      if #kids > 0 then kind = "form" end
    elseif #kids > 0 or etype == "nesting" or etype == "subprocess" then
      kind = (etype == "subprocess") and "subprocess"
          or (etype == "template") and "subgraph" or "nesting"
    end
    -- event types: data (has a data type), computation / DMN (has a
    -- computation expression; DMN if the expression is of type DMN),
    -- global (event scope)
    local comp = attr(ev, "computation")
    local ctype = comp and comp ~= "" and (exprtype[comp] or "")
    local scope = child(custom, "eventScope")
    -- colours from the file (background, border, text), each only if it
    -- differs from the portal default (= the package default)
    local colors = child(custom, "visualization", "colors")
    local function color(name)
      local c = colors and attr(colors, name)
      c = c and c:match("^#?(%x%x%x%x%x%x)$")
      if not c or c:lower() == DEFAULT_COLOR[name:lower()] then return nil end
      return c:upper()
    end
    graph.nodes[#graph.nodes + 1] = {
      id = id, label = labels[id] or id, roles = roles, kind = kind,
      -- only events show receivers (not collections)
      receivers = kind == "activity" and receivers or {},
      children = kids,
      x = num(loc and attr(loc, "xLoc")),
      y = num(loc and attr(loc, "yLoc")),
      -- the portal stores no size: default box
      w = size and num(attr(size, "width")) or DEFAULT_SIZE[tool][1],
      h = size and num(attr(size, "height")) or DEFAULT_SIZE[tool][2],
      executed = executed[id], pending = pending[id],
      -- the marking lists activities only; nestings are never excluded
      excluded = kind == "activity" and included ~= nil and not included[id],
      data = child(custom, "eventData", "dataType") ~= nil,
      computation = ctype and ctype:upper() ~= "DMN",
      dmn = ctype and ctype:upper() == "DMN",
      global = scope ~= nil and (scope:get_text() or ""):match("^%s*global%s*$") ~= nil,
      -- an empty subgraph (template, target of spawns) is drawn as an event;
      -- one with events is a collection (kind "subgraph")
      subgraph = etype == "template" and kind == "activity",
      form = etype == "form" and kind == "activity",
      bg = color("bg"), stroke = color("stroke"), text = color("textStroke"),
      -- collections without a size in the file (portal): box from the
      -- children, see layout
      autosize = kind ~= "activity" and not size,
    }
    local n = graph.nodes[#graph.nodes]
    -- with receivers the portal draws the box one header strip taller
    -- (the receiver band at the bottom; same top edge)
    if #n.receivers > 0 and not size and tool == "portal" then
      n.h = n.h + PORTAL_HEADER
    end
    -- the nominal box (at the location, default size): a collection's box
    -- is computed from its children's nominal boxes
    n.ny, n.nh = n.y, n.h
    -- boxes without a header strip -- an empty subgraph, and an empty
    -- nesting or subprocess -- are drawn 20 px lower and shorter in the
    -- portal (same bottom edge)
    local empty_collection = kind ~= "activity" and #kids == 0
    if (n.subgraph or empty_collection) and not size and tool == "portal" then
      n.y = n.y + PORTAL_HEADER
      n.h = n.h - PORTAL_HEADER
    end
    return id
  end
  local top = {}
  for _, ev in ipairs(elements(child(res, "events"), "event")) do
    top[#top + 1] = read_event(ev)
  end
  if #elements(child(res, "subProcesses")) > 0 then
    warn("<subProcesses> are not supported yet; skipped")
  end

  -- relations
  for _, group in ipairs(elements(child(spec, "constraints"))) do
    local gname = ename(group)
    local rk
    for k, v in pairs(relation_kinds) do          -- names compared in lower case
      if k:lower() == gname then rk = v end
    end
    local rels = elements(group)
    if not rk then
      if #rels > 0 then
        warn(#rels .. " relation(s) of type <" .. gname .. "> not supported; skipped")
      end
    else
      for _, r in ipairs(rels) do
        local wps = {}
        for _, w in ipairs(elements(child(r, "custom", "waypoints"), "waypoint")) do
          wps[#wps + 1] = { num(attr(w, "x")), num(attr(w, "y")) }
        end
        -- a time: only conditions (delay) and responses (deadline) have one;
        -- the portal also stores it on the milestone half of a
        -- pre-condition (linked to its condition, see merge_linked)
        local delay = attr(r, "time")
        local linked_milestone = rk.kind == "milestone" and (attr(r, "link") or "") ~= ""
        if delay and delay ~= "" and rk.kind ~= "condition" and rk.kind ~= "response"
            and not linked_milestone then
          warn(rk.kind .. " from `" .. tostring(attr(r, "sourceId")) .. "' to `"
            .. tostring(attr(r, "targetId")) .. "' has a time; only conditions and"
            .. " responses have one, ignored")
          delay = nil
        end
        local link = attr(r, "link")
        -- guard: the expression referenced by expressionId
        local eid = attr(r, "expressionId")
        local guard = eid and exprvalue[eid]
        if guard then guard = guard:gsub("^%s+", ""):gsub("%s+$", "") end
        graph.relations[#graph.relations + 1] = {
          kind = rk.kind,
          from = attr(r, "sourceId"), to = attr(r, "targetId"),
          waypoints = wps,
          delay = (delay and delay ~= "") and delay or nil,
          link = (link and link ~= "") and link or nil,
          guard = (guard and guard ~= "") and guard or nil,
        }
      end
    end
  end
  return top
  end   -- read_graph

  read_graph(root, {})
  graph.relations = merge_linked(graph.relations)
  return graph
end

-- ------------------------------------------------------------------
--  Front end 2: DCR-js XML, DCR-js's own format (bpmn-js style):
--    <dcr:definitions>
--      <dcr:dcrGraph>   events, nestings, subprocesses (nested in each
--                       other) and relations (at any level)
--        <dcr:event id description role included executed pending/>
--        <dcr:nesting id description> ... </dcr:nesting>
--        <dcr:subProcess id description ...> ... </>
--        <dcr:relation id type sourceRef targetRef/>
--      <dcrDi:dcrRootBoard><dcrDi:dcrPlane>   the drawing:
--        <dcrDi:dcrShape boardElement=id><dc:Bounds x y width height/>
--        <dcrDi:relation boardElement=id><dcrDi:waypoint x y/>...
--  Positions in px, top left, y down, 50 px/cm (as the portal export).
--  DCR-js has no guards, times, pre-conditions, logical includes, event
--  types or colours; anything it does not know is warned about and skipped.
-- ------------------------------------------------------------------
local dcrjs_relation_kinds = {
  condition = "condition", response = "response", include = "include",
  exclude = "exclude", milestone = "milestone", update = "update",
  spawn = "spawn", coresponse = "noresponse",
}

local function read_dcrjs(dom)
  local root = child(dom:root_node(), "definitions")
  if not root then fail("no <dcr:definitions> element found") end
  local gel = child(root, "dcrGraph")
  if not gel then fail("no <dcr:dcrGraph> element found") end
  local graph = { nodes = {}, relations = {}, px_per_cm = PX_PER_CM.dcrjs }

  -- the drawing: boxes and relation routes, by the id of their element
  local bounds, routes = {}, {}
  for _, el in ipairs(elements(child(root, "dcrRootBoard", "dcrPlane"))) do
    local id, n = attr(el, "boardElement"), ename(el)
    if n == "dcrshape" then
      local b = child(el, "Bounds")
      if id and b then
        bounds[id] = { num(attr(b, "x")), num(attr(b, "y")),
                       num(attr(b, "width")), num(attr(b, "height")) }
      end
    elseif n == "relation" and id then
      local wps = {}
      for _, w in ipairs(elements(el, "waypoint")) do
        wps[#wps + 1] = { num(attr(w, "x")), num(attr(w, "y")) }
      end
      routes[id] = wps
    end
  end

  local kinds = { event = "activity", nesting = "nesting", subprocess = "subprocess" }
  local function yes(el, name) return (attr(el, name) or ""):lower() == "true" end
  -- the elements inside `el' (children before parents); returns the ids
  -- of its events / collections
  local function read_level(el)
    local ids = {}
    for _, c in ipairs(elements(el)) do
      local n = ename(c)
      if kinds[n] then
        local id = attr(c, "id")
        local kids = read_level(c)
        local kind = kinds[n]
        if kind == "activity" and #kids > 0 then kind = "nesting" end
        local roles = {}
        for r in (attr(c, "role") or ""):gmatch("[^,]+") do
          r = r:gsub("^%s+", ""):gsub("%s+$", "")
          if r ~= "" then roles[#roles + 1] = r end
        end
        local b = bounds[id]
        if not b then
          warn("event `" .. id .. "' has no position; placed at (0,0)")
          b = { 0, 0, DEFAULT_SIZE.dcrjs[1], DEFAULT_SIZE.dcrjs[2] }
        end
        local label = attr(c, "description")
        graph.nodes[#graph.nodes + 1] = {
          id = id, label = (label and label ~= "") and label or id,
          roles = roles, kind = kind, children = kids,
          x = b[1], y = b[2], w = b[3], h = b[4],
          executed = yes(c, "executed"), pending = yes(c, "pending"),
          -- nestings carry no marking
          excluded = kind ~= "nesting" and attr(c, "included") ~= nil
                     and not yes(c, "included"),
        }
        ids[#ids + 1] = id
      elseif n == "relation" then
        local t = (attr(c, "type") or ""):lower()
        local kind = dcrjs_relation_kinds[t]
        if not kind then
          warn("relation `" .. tostring(attr(c, "id")) .. "' of type `" .. t
            .. "' not supported; skipped")
        else
          graph.relations[#graph.relations + 1] = {
            kind = kind, from = attr(c, "sourceRef"), to = attr(c, "targetRef"),
            waypoints = routes[attr(c, "id")] or {},
          }
        end
      else
        warn("element <" .. c:get_element_name() .. "> not supported; skipped")
      end
    end
    return ids
  end
  read_level(gel)
  return graph
end

-- the format of a file, from its root element
local function detect_format(dom)
  local root = elements(dom:root_node())[1]
  local n = root and ename(root)
  if n == "dcrgraph" then return "dcrsolutions" end
  if n == "definitions" then return "dcrjs" end
  fail("unknown file format: root element <" ..
    (root and root:get_element_name() or "?") .. ">")
end

local front_ends = {
  dcrsolutions = read_dcrsolutions,
  dcrjs = read_dcrjs,
}
-- format= : the format is always detected from the file; these names are
-- accepted (dcrsolutionsxml: old name)
local format_names = { auto = true, dcrsolutions = "dcrsolutions",
  dcrsolutionsxml = "dcrsolutions", dcrjs = "dcrjs" }

-- ------------------------------------------------------------------
--  Emitter: model -> dcrgraph code (list of lines)
-- ------------------------------------------------------------------
local escapes = {
  ["\\"] = "\\textbackslash{}", ["{"] = "\\{", ["}"] = "\\}",
  ["&"] = "\\&", ["%"] = "\\%", ["#"] = "\\#", ["$"] = "\\$", ["_"] = "\\_",
  ["~"] = "\\textasciitilde{}", ["^"] = "\\textasciicircum{}",
}
local function escape(s)
  return (s:gsub("[\\{}&%%#$_~^]", escapes))
end

-- 1.230000 -> 1.23
local function fmt(v)
  local s = string.format("%.3f", v):gsub("0+$", ""):gsub("%.$", "")
  if s == "-0" then s = "0" end
  return s
end

-- ------------------------------------------------------------------
--  Layout: model -> geometry in cm (y up), used by the emitter and by the
--  layout tests. Kept apart from the content so that a change of
--  positions only affects this step.
--    lay.ids[id]      node name in the LaTeX code
--    lay.node[id]     activities: {x, y (centre), w, h}
--                     nestings:   {x1, y1, x2, y2} (area corners)
--    lay.via[r]       relation r (index): list of {x, y}, or nil
--    lay.port, lay.selfpos, lay.radj, lay.nextra: see below
-- ------------------------------------------------------------------

-- Sizes of the package in cm: the end markers, the parallel distance and
-- the gap between self-relation markers. Under LuaLaTeX the values in
-- force (\dcrset{marker size=..., parallel distance=...}); on the command
-- line and in the tests the defaults.
local PT = 2.54 / 72.27                    -- 1pt in cm
local function package_sizes()
  local z = { marker = 10.3 * PT, pardist = 13.5 * PT, selfgap = 2 * PT,
              border = 1.5 * PT }
  if in_tex then
    for key, reg in pairs({ marker = "dcr@rsize", pardist = "dcr@pardist",
                            border = "dcr@border" }) do
      local ok, sp = pcall(tex.getglue, reg)
      if ok and type(sp) == "number" and sp > 0 then z[key] = sp / 65536 * PT end
    end
  end
  return z
end

-- The relations named by t ({from, kind, to, text}, see parse_targets).
-- Warns (as `what') if there is none, or several and no type was given
-- (all of them are `verb').
local function find_relations(graph, t, what, verb)
  local found = {}
  for i, r in ipairs(graph.relations) do
    if r.from == t.from and r.to == t.to and (not t.kind or t.kind == r.kind) then
      found[#found + 1] = i
    end
  end
  if #found == 0 then
    warn(what .. ": no relation `" .. t.text .. "' in the file")
  elseif #found > 1 and not t.kind then
    warn(what .. ": `" .. t.text .. "' matches " .. #found ..
      " relations; all are " .. verb .. " (add the relation type to pick one)")
  end
  return found
end

-- node ids: letters, digits, _ only; kept unique
local function node_ids(graph)
  local ids, used = {}, {}
  for _, n in ipairs(graph.nodes) do
    local base = n.id:gsub("[^%w_]", "_")
    local id, k = base, 1
    while used[id] do k = k + 1; id = base .. "_" .. k end
    used[id] = true
    ids[n.id] = id
  end
  return ids
end

-- \adjustactivity: the moves (shift, xshift, yshift) in cm per node --
-- moving a collection moves everything inside it -- and the other
-- options per node (passed to the node)
local function node_adjustments(graph, opts)
  local byid, shift, extra = {}, {}, {}
  for _, n in ipairs(graph.nodes) do byid[n.id] = n end
  local function move(id, dx, dy)
    local sh = shift[id] or { 0, 0 }
    shift[id] = { sh[1] + dx, sh[2] + dy }
    for _, c in ipairs(byid[id].children) do move(c, dx, dy) end
  end
  for _, a in ipairs(opts.adjust.activities) do
    if not byid[a.id] then
      warn("\\adjustactivity: no activity `" .. a.id .. "' in the file")
    else
      if a.dx ~= 0 or a.dy ~= 0 then move(a.id, a.dx, a.dy) end
      for _, e in ipairs(a.extra) do
        extra[a.id] = extra[a.id] or {}
        table.insert(extra[a.id], e)
      end
    end
  end
  return shift, extra
end

-- The boxes: lay.node[id] = {x, y, w, h} (activities: centre, size) or
-- {x1, y1, x2, y2} (collections: corners). Positions are scaled, sizes
-- are not (text does not scale either). lay.nom[id] = {left, top, right,
-- bottom}: the nominal box (at the location, full height incl. a header
-- strip that may not be drawn); collections without a size are the box
-- around their children's nominal boxes (children come first).
local function place_nodes(graph, opts, lay, shift)
  local ppc = graph.px_per_cm
  local s = opts.scale / ppc                -- px -> cm (positions)
  lay.nom = {}
  for _, n in ipairs(graph.nodes) do
    local sh = shift[n.id] or { 0, 0 }
    local cx, cy = (n.x + n.w / 2) * s + sh[1], -(n.y + n.h / 2) * s + sh[2]
    local w, h = n.w / ppc, n.h / ppc
    local ny, nh = n.ny or n.y, n.nh or n.h
    local ncy = -(ny + nh / 2) * s + sh[2]
    local nominal = { cx - w / 2, ncy + nh / ppc / 2, cx + w / 2, ncy - nh / ppc / 2 }
    if n.kind == "activity" then
      lay.node[n.id] = { x = cx, y = cy, w = w, h = h }
      lay.nom[n.id] = nominal
    elseif n.autosize and #n.children > 0 then
      local x1, y1, x2, y2 = math.huge, -math.huge, -math.huge, math.huge
      for _, c in ipairs(n.children) do
        local l, t, r, b = table.unpack(lay.nom[c])
        x1, y1, x2, y2 = math.min(x1, l), math.max(y1, t), math.max(x2, r), math.min(y2, b)
      end
      local p = COLLECTION_PAD
      -- a form has a header strip: 20 px more at the top (portal, measured)
      local top = p.top + (n.kind == "form" and PORTAL_HEADER or 0)
      lay.node[n.id] = { x1 = x1 - p.left / ppc, y1 = y1 + top / ppc,
                         x2 = x2 + p.right / ppc, y2 = y2 - p.bottom / ppc }
      local g = lay.node[n.id]
      lay.nom[n.id] = { g.x1, g.y1, g.x2, g.y2 }
    else
      lay.node[n.id] = { x1 = cx - w / 2, y1 = cy + h / 2,
                         x2 = cx + w / 2, y2 = cy - h / 2 }
      lay.nom[n.id] = nominal
    end
  end
  -- the routes from the file (used with the waypoints option)
  for i, r in ipairs(graph.relations) do
    if r.from ~= r.to and #r.waypoints > 0 then
      local p = {}
      for _, w in ipairs(r.waypoints) do p[#p + 1] = { w[1] * s, -w[2] * s } end
      lay.via[i] = p
    end
  end
end

-- \adjustrelation: relation index -> its adjustment
-- ({from = anchor, to = anchor, extra = {options}})
local function relation_adjustments(graph, opts)
  local radj = {}
  for _, a in ipairs(opts.adjust.relations) do
    for _, i in ipairs(find_relations(graph, a.target, "\\adjustrelation", "adjusted")) do
      radj[i] = a
    end
  end
  return radj
end

-- centre and half sizes of a box
local function box(lay, id)
  local g = lay.node[id]
  if g.w then return g.x, g.y, g.w / 2, g.h / 2 end
  return (g.x1 + g.x2) / 2, (g.y1 + g.y2) / 2, (g.x2 - g.x1) / 2, (g.y1 - g.y2) / 2
end

-- a side's coordinate t: from the middle of the side, counterclockwise
-- around the box (right side: up, top: to the left, left: down, bottom:
-- to the right)
local function to_t(side, cx, cy, x, y)
  if side == "right" then return y - cy
  elseif side == "top" then return cx - x
  elseif side == "left" then return cy - y
  else return x - cx end
end
local function from_t(side, cx, cy, hw, hh, t)
  if side == "right" then return cx + hw, cy + t
  elseif side == "top" then return cx - t, cy + hh
  elseif side == "left" then return cx - hw, cy - t
  else return cx + t, cy - hh end
end

-- how steeply a line in direction (dx, dy) leaves a side: the sine of the
-- angle between them (1 = at a right angle)
local function steepness(side, dx, dy)
  local l = math.sqrt(dx * dx + dy * dy)
  if l < 1e-9 then return 1 end
  return math.abs((side == "right" or side == "left") and dx or dy) / l
end

-- Ports: where each straight relation meets its two boxes. Every line
-- gets its own attachment point (port) on each end, independently: per
-- box and side, the lines attached there are sorted along the side (by
-- where they would leave it, so that they do not cross; parallel
-- relations in mirrored order at their two ends, so that they stay
-- parallel) and placed at even distances (the parallel distance across
-- the lines), centred on where they would leave; groups that come too
-- close are merged, a group longer than the side is squeezed. Markers sit
-- at the ports (on slanted lines a little along them), so no
-- two of them overlap on a box. The line runs straight from port to port:
-- emitted as via={(port 1),(port 2)}, two points on the box outlines,
-- which the package uses as the exact start and end (not as anchors
-- <id>.<angle>: TikZ rounds those angles to whole degrees, differently at
-- the two ends, and parallel lines came out tilted).
-- Not for: self-relations, relations along a route (waypoints), adjusted
-- relations (\adjustrelation), relations between a box and a box inside
-- it (these are spread by the package, see \dcr@parallel).
-- lay.port[i] = {{x, y} at the source, {x, y} at the target} in cm;
-- lay.ports[node id] = list of {side, t, i, e} (t along the side).
local function assign_ports(graph, opts, lay, z)
  lay.port, lay.ports = {}, {}
  local PD = z.pardist
  local MARGIN = z.marker / 2 + 0.12    -- from the corners: half a marker + a little
  local SELFSTEP = z.marker + z.selfgap -- self markers, see place_self_markers
  local function inside(a, b)           -- box a inside box b (or the same)
    local ax, ay, aw, ah = box(lay, a)
    local bx, by, bw, bh = box(lay, b)
    return ax - aw >= bx - bw - 1e-6 and ax + aw <= bx + bw + 1e-6
       and ay - ah >= by - bh - 1e-6 and ay + ah <= by + bh + 1e-6
  end
  local nself = {}
  for _, r in ipairs(graph.relations) do
    if r.from == r.to then nself[r.from] = (nself[r.from] or 0) + 1 end
  end
  local attach = {}             -- "id|side" -> list of attachments
  for i, r in ipairs(graph.relations) do
    local routed = opts.waypoints and lay.via[i]
    if r.from ~= r.to and lay.node[r.from] and lay.node[r.to] and not routed
       and not lay.radj[i] and not inside(r.from, r.to) and not inside(r.to, r.from) then
      lay.port[i] = {}
      for e, at in ipairs({ r.from, r.to }) do
        local other = (e == 1) and r.to or r.from
        local cx, cy, hw, hh = box(lay, at)
        local ox, oy = box(lay, other)
        local dx, dy = ox - cx, oy - cy
        -- where the line between the centres leaves the box
        local tx = dx ~= 0 and hw / math.abs(dx) or math.huge
        local ty = dy ~= 0 and hh / math.abs(dy) or math.huge
        local side = (tx < ty) and (dx > 0 and "right" or "left")
                                or (dy > 0 and "top" or "bottom")
        local k = math.min(tx, ty)
        local key = at .. "|" .. side
        attach[key] = attach[key] or { id = at, side = side }
        -- parallel relations: the same order at both ends seen from one of
        -- them, i.e. mirrored around the boxes: the index counts up at the
        -- end with the smaller id, down at the other
        local tie = ((at < other) and 1 or -1) * i
        table.insert(attach[key], { i = i, e = e, side = side,
          t = to_t(side, cx, cy, cx + k * dx, cy + k * dy), tie = tie,
          sin = steepness(side, dx, dy) })
      end
    end
  end
  local keys = {}
  for key in pairs(attach) do keys[#keys + 1] = key end
  table.sort(keys)              -- (deterministic output)
  for _, key in ipairs(keys) do
    table.sort(attach[key], function(p, q)
      if math.abs(p.t - q.t) > 1e-6 then return p.t < q.t end
      return p.tie < q.tie
    end)
  end
  -- the ports of one side
  local function place_side(list)
    local side, id = list.side, list.id
    local cx, cy, hw, hh = box(lay, id)
    local half = (side == "right" or side == "left") and hh or hw
    local lo, hi = -half + MARGIN, half - MARGIN
    -- top edge: t runs from right to left; the self-relation markers take
    -- the left end (and keep their clearance from the ports, see
    -- place_self_markers)
    if side == "top" and nself[id] then
      local h2 = half - nself[id] * SELFSTEP - z.marker / 2 - 0.05
      if h2 > lo then hi = math.min(hi, h2) end   -- (no room: ignore them)
    end
    if lo > hi then lo, hi = 0, 0 end
    -- groups of consecutive attachments: {first, last, centre, spacing}.
    -- The parallel distance is measured across the lines, as for parallel
    -- relations in the package: along the side, lines that meet it at an
    -- angle need PD / sin(angle) (the angle at least about 17 degrees)
    local groups = {}
    for j = 1, #list do groups[j] = { a = j, b = j } end
    local function place(g)     -- centre and spacing of a group, on the side
      local n, sum, s = g.b - g.a + 1, 0, 1
      for j = g.a, g.b do sum = sum + list[j].t; s = math.min(s, list[j].sin) end
      g.need = PD / math.max(s, 0.3)
      local sp = g.need
      if n > 1 and (n - 1) * sp > hi - lo then sp = (hi - lo) / (n - 1) end
      local len = (n - 1) * sp
      local c = math.max(lo + len / 2, math.min(hi - len / 2, sum / n))
      g.c, g.sp, g.len = c, sp, len
    end
    for _, g in ipairs(groups) do place(g) end
    local merged = true
    while merged do
      merged = false
      for q = 1, #groups - 1 do
        local g, h = groups[q], groups[q + 1]
        -- the gap between the last port of g and the first of h
        if (h.c - h.len / 2) - (g.c + g.len / 2) < math.max(g.need, h.need) - 1e-9 then
          groups[q] = { a = g.a, b = h.b }
          place(groups[q])
          table.remove(groups, q + 1)
          merged = true
          break
        end
      end
    end
    for _, g in ipairs(groups) do
      for j = g.a, g.b do
        local t = g.c - g.len / 2 + (j - g.a) * g.sp
        local x, y = from_t(side, cx, cy, hw, hh, t)
        local at = list[j]
        lay.port[at.i][at.e] = { x, y }
        table.insert(lay.ports[id], { side = side, t = t, i = at.i, e = at.e })
      end
    end
  end
  -- (the angles are those of the lines between the box centres: those
  -- between the ports would feed back -- spreading slanted lines along a
  -- side makes them more slanted)
  for _, key in ipairs(keys) do
    lay.ports[attach[key].id] = lay.ports[attach[key].id] or {}
    place_side(attach[key])
  end
end

-- Self-relations: their markers are lined up on the top edge of the box
-- from the left corner, in the portal's order, skipping the places where
-- other relations meet that edge (their ports). If they do not fit on
-- the edge that way, they may touch the markers of those lines (no gap);
-- if that does not fit either, they run past the right corner (with a
-- warning): never onto a line, where a marker would read as the marker of
-- that line. lay.selfpos[i] = centre of the marker from the box's
-- left edge, in cm.
local SELF_ORDER = { include = 1, exclude = 2, response = 3, noresponse = 4,
  update = 5, spawn = 6, logicalinclude = 7, condition = 8,
  precondition = 9, milestone = 10 }
-- relations with their marker at the target (dcr-solutions notation)
local MARKER_AT_TARGET = { condition = true, milestone = true, precondition = true }
-- does relation kind have a marker at its end e (1 source, 2 target)?
-- coopis23: the circle at the target (the triangle at the source sits on
-- the port, inside the line's clearance); classic draws self-relations as
-- loops at the corners, the markers on the top edge do not matter there
local function marker_at(kind, e, notation)
  if notation == "coopis23" then return e == 2 end
  if notation == "classic" then return true end
  return (e == 2) == (MARKER_AT_TARGET[kind] == true)
end

local function place_self_markers(graph, opts, lay, z)
  lay.selfpos = {}
  local RS = z.marker
  local STEP = RS + z.selfgap
  -- a line on the top edge occupies its port (a self marker keeps half a
  -- marker from it); the marker of a relation at this end -- where the
  -- package puts it (\dcr@computeend): moved along the line until it
  -- clears the side, h / sin, at most 4h -- occupies its place if it
  -- reaches the row of the self markers (also from a side near the top
  -- corner); a self marker keeps a full step from it.
  -- occupied[id] = list of {x from the left edge, clearance, marker = true|nil}
  local occupied = {}
  local h = RS / 2 + z.border / 2
  for id, list in pairs(lay.ports) do
    local cx, cy, hw, hh = box(lay, id)
    local left, top = cx - hw, cy + hh
    occupied[id] = {}
    for _, p in ipairs(list) do
      local a, b = lay.port[p.i][p.e], lay.port[p.i][3 - p.e]
      if p.side == "top" then table.insert(occupied[id], { a[1] - left, RS / 2 + 0.05 }) end
      if marker_at(graph.relations[p.i].kind, p.e, opts.notation) then
        local dx, dy = b[1] - a[1], b[2] - a[2]
        local l = math.sqrt(dx * dx + dy * dy)
        local along = math.min(h / math.max(steepness(p.side, dx, dy), 0.2), 4 * h)
        local mx, my = a[1] + along * dx / l, a[2] + along * dy / l
        if my > top - h then
          table.insert(occupied[id], { mx - left, STEP, marker = true })
        end
      end
    end
  end
  local selfs = {}
  for i, r in ipairs(graph.relations) do
    if r.from == r.to then
      selfs[r.from] = selfs[r.from] or {}
      table.insert(selfs[r.from], i)
    end
  end
  local ids = {}
  for id in pairs(selfs) do ids[#ids + 1] = id end
  table.sort(ids)               -- (deterministic warnings)
  for _, id in ipairs(ids) do
    local list = selfs[id]
    table.sort(list, function(a, b)
      local ka = SELF_ORDER[graph.relations[a].kind] or 99
      local kb = SELF_ORDER[graph.relations[b].kind] or 99
      if ka ~= kb then return ka < kb end
      return a < b
    end)
    local occ = occupied[id] or {}
    table.sort(occ, function(p, q) return p[1] < q[1] end)
    local _, _, hw = box(lay, id)
    local last = 2 * hw - RS / 2  -- the rightmost centre on the edge
    -- left to right; something in the way (keep(o): its clearance, or nil
    -- to ignore it): continue right next to it
    local function line_up(keep)
      local pos, x = {}, RS / 2
      for k = 1, #list do
        local moved = true
        while moved do
          moved = false
          for _, o in ipairs(occ) do
            local c = keep(o)
            -- (tolerance: (o + c) - o can come out a hair below c, which
            -- would loop forever)
            if c and math.abs(x - o[1]) < c - 1e-9 then x = o[1] + c; moved = true end
          end
        end
        pos[k] = x
        x = x + STEP
      end
      return pos, pos[#pos] <= last + 1e-9
    end
    local pos, fits = line_up(function(o) return o[2] end)
    if not fits then   -- touching the markers of the lines, no gap
      pos, fits = line_up(function(o) return o.marker and RS or o[2] end)
    end
    if not fits then
      warn("the top edge of `" .. id .. "' is too short for its " .. #list ..
        " self-relation markers and the lines there; the markers run past"
        .. " its right corner")
    end
    for k, i in ipairs(list) do lay.selfpos[i] = pos[k] end
  end
end

-- Layout: the steps above, in this order
local function layout(graph, opts)
  local z = package_sizes()
  local lay = { ids = node_ids(graph), node = {}, via = {} }
  local shift
  shift, lay.nextra = node_adjustments(graph, opts)
  place_nodes(graph, opts, lay, shift)
  lay.radj = relation_adjustments(graph, opts)
  assign_ports(graph, opts, lay, z)
  place_self_markers(graph, opts, lay, z)
  return lay
end

-- Which values of which relation are shown as text, from the options
-- guards/delays/deadlines={list of relations}. Result: relation index ->
-- list of "guard", "delay", "deadline". Warns about names that match no
-- relation, and about relations without such a value.
local part_of = { guards = "guard", delays = "delay", deadlines = "deadline" }
function M.explicit_parts(graph, opts)
  local result = {}
  for _, key in ipairs({ "guards", "delays", "deadlines" }) do
    local part = part_of[key]
    for _, t in ipairs(opts.targets[key] or {}) do
      for _, i in ipairs(find_relations(graph, t, key, "used")) do
        local r = graph.relations[i]
        local has
        if part == "guard" then has = r.guard ~= nil
        elseif part == "deadline" then has = r.delay ~= nil and r.kind == "response"
        else has = r.delay ~= nil and r.kind ~= "response" end
        if not has then
          warn(key .. ": relation `" .. r.from .. " " .. r.kind .. " " .. r.to ..
            "' has no " .. part .. (part ~= "guard" and r.delay and
            " (its time is a " .. (r.kind == "response" and "deadline" or "delay") .. ")" or ""))
        else
          result[i] = result[i] or {}
          table.insert(result[i], part)
        end
      end
    end
  end
  return result
end

local function emit(graph, opts, lay)
  local ids = lay.ids
  local function pt(p) return "(" .. fmt(p[1]) .. "," .. fmt(p[2]) .. ")" end

  local out = {}
  local function add(line) out[#out + 1] = line end
  -- colours from the file, defined once each, named dcrcolRRGGBB
  local seen = {}
  for _, n in ipairs(graph.nodes) do
    for _, key in ipairs({ "bg", "stroke", "text" }) do
      local c = n[key]
      if c and not seen[c] then
        seen[c] = true
        add("\\definecolor{dcrcol" .. c .. "}{HTML}{" .. c .. "}")
      end
    end
  end
  local env = {}
  if opts.notation then env[#env + 1] = "notation=" .. opts.notation end
  if opts.explicit_all then env[#env + 1] = "explicit" end
  for _, k in ipairs({ "guards", "delays", "deadlines" }) do
    if opts[k] then env[#env + 1] = k .. "=" .. opts[k] end
  end
  for _, sz in ipairs(opts.size) do env[#env + 1] = sz[1] .. "={" .. sz[2] .. "}" end
  -- guards/delays/deadlines={...}: mark the named relations; explicit[i]
  -- = the parts of relation i to show as text
  local explicit = M.explicit_parts(graph, opts)
  add("\\begin{dcrgraph}" .. (#env > 0 and "[" .. table.concat(env, ", ") .. "]" or ""))

  for _, n in ipairs(graph.nodes) do
    local o = {}
    if #n.roles > 0 then
      local role = escape(table.concat(n.roles, ","))   -- "Role1,Role2", as in the portal
      if role:find("[,=]") then role = "{" .. role .. "}" end
      o[#o + 1] = "role=" .. role
    end
    if n.receivers and #n.receivers > 0 then
      local receiver = escape(table.concat(n.receivers, ","))
      if receiver:find("[,=]") then receiver = "{" .. receiver .. "}" end
      o[#o + 1] = "receiver=" .. receiver
    end
    if opts.marking then
      if n.executed then o[#o + 1] = "executed" end
      if n.pending then o[#o + 1] = "pending" end
      if n.excluded then o[#o + 1] = "excluded" end
    end
    for _, flag in ipairs({ "data", "computation", "dmn", "global", "subgraph", "form" }) do
      if n[flag] then o[#o + 1] = flag end
    end
    if n.bg then o[#o + 1] = "bgcolor=dcrcol" .. n.bg end
    if n.stroke then o[#o + 1] = "bordercolor=dcrcol" .. n.stroke end
    if n.text then o[#o + 1] = "textcolor=dcrcol" .. n.text end
    -- \adjustactivity: further options, after ours (so they win)
    local extra = lay.nextra[n.id] or {}
    local g = lay.node[n.id]
    if n.kind == "activity" then
      o[#o + 1] = "at={" .. pt({ g.x, g.y }) .. "}"
      o[#o + 1] = "minimum width=" .. fmt(g.w) .. "cm"
      o[#o + 1] = "minimum height=" .. fmt(g.h) .. "cm"
      for _, e in ipairs(extra) do o[#o + 1] = e end
      add(string.format("  \\activity[%s]{%s}{%s}",
        table.concat(o, ", "), escape(n.label), ids[n.id]))
    else
      -- the box from the file (exact size)
      o[#o + 1] = "area={" .. pt({ g.x1, g.y1 }) .. pt({ g.x2, g.y2 }) .. "}"
      for _, e in ipairs(extra) do o[#o + 1] = e end
      local kids = {}
      for _, c in ipairs(n.children) do kids[#kids + 1] = ids[c] end
      add(string.format("  \\%s[%s]{%s}{%s}{%s}", n.kind,
        table.concat(o, ", "), escape(n.label), ids[n.id], table.concat(kids, ", ")))
    end
  end

  for i, r in ipairs(graph.relations) do
    local from, to = ids[r.from], ids[r.to]
    if not from or not to then
      warn(r.kind .. " from `" .. tostring(r.from) .. "' to `" .. tostring(r.to)
        .. "': unknown event; skipped")
    else
      local o = {}
      -- the time: the deadline of a response, the delay of a condition
      if r.delay then
        o[#o + 1] = (r.kind == "response" and "deadline" or "delay")
          .. "={" .. escape(r.delay) .. "}"
      end
      if r.guard then o[#o + 1] = "guard={" .. escape(r.guard) .. "}" end
      if explicit[i] then o[#o + 1] = "explicit={" .. table.concat(explicit[i], ",") .. "}" end
      -- the ports: the exact start and end of the line on the two box
      -- outlines (see layout)
      local port = lay.port[i]
      if port then o[#o + 1] = "via={" .. pt(port[1]) .. "," .. pt(port[2]) .. "}" end
      if lay.selfpos[i] then o[#o + 1] = "selfpos=" .. fmt(lay.selfpos[i]) .. "cm" end
      if opts.waypoints and lay.via[i] then
        local p = {}
        for _, w in ipairs(lay.via[i]) do p[#p + 1] = pt(w) end
        o[#o + 1] = "via={" .. table.concat(p, ",") .. "}"
      end
      -- \adjustrelation: start/end at an anchor of the box, further options
      local a = lay.radj[i]
      if a then
        if a.from then from = from .. "." .. a.from end
        if a.to then to = to .. "." .. a.to end
        for _, e in ipairs(a.extra) do o[#o + 1] = e end
      end
      add(string.format("  \\%s%s{%s}{%s}", r.kind,
        #o > 0 and "[" .. table.concat(o, ", ") .. "]" or "", from, to))
    end
  end
  add("\\end{dcrgraph}")
  return out
end

-- ------------------------------------------------------------------
--  Options
-- ------------------------------------------------------------------
local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end

local function truthy(v)
  return v == nil or v == "" or v == "true" or v == "yes" or v == "1"
end

-- Relations named in an option, e.g. guards={A4 response A6, A1 A2}:
-- "source type target" or "source target" (type optional, needed only
-- if there are several relations between the two). Ids as in the file;
-- `value' is the portal's name of \update.
local relation_types = { condition = 1, response = 1, include = 1, exclude = 1,
  milestone = 1, update = 1, noresponse = 1, precondition = 1, spawn = 1,
  logicalinclude = 1 }
local type_aliases = { value = "update", coresponse = "noresponse",
  ["pre-condition"] = "precondition", ["logical-include"] = "logicalinclude",
  ["no-response"] = "noresponse" }

local function parse_targets(key, v)
  local list = {}
  for item in ((v or "") .. ","):gmatch("([^,]*),") do
    item = trim(item)
    if item ~= "" then
      local w = {}
      for word in item:gmatch("%S+") do w[#w + 1] = word end
      local from, kind, to
      if #w == 2 then from, to = w[1], w[2]
      elseif #w == 3 then from, kind, to = w[1], w[2]:lower(), w[3]
      else
        fail(key .. "={" .. v .. "}: `" .. item ..
          "' is not of the form `source type target' or `source target'")
      end
      if kind then
        kind = type_aliases[kind] or kind
        if not relation_types[kind] then
          fail(key .. "={" .. v .. "}: unknown relation type `" .. w[2] .. "' in `" .. item .. "'")
        end
      end
      list[#list + 1] = { from = from, kind = kind, to = to, text = item }
    end
  end
  return list
end

-- "a, b={c,d}" -> {"a", "b={c,d}"}: top-level commas only, trimmed,
-- empty items left out
local function split_top(str)
  local parts, depth, cur = {}, 0, ""
  for c in (str or ""):gmatch(".") do
    if c == "{" then depth = depth + 1 elseif c == "}" then depth = depth - 1 end
    if c == "," and depth == 0 then parts[#parts + 1] = trim(cur); cur = ""
    else cur = cur .. c end
  end
  parts[#parts + 1] = trim(cur)
  local result = {}
  for _, p in ipairs(parts) do if p ~= "" then result[#result + 1] = p end end
  return result
end

-- "key = value" -> "key", "value" (trimmed); "key" -> "key", nil
local function keyval(p)
  local k, v = p:match("^([^=]-)%s*=%s*(.*)$")
  return trim(k or p), v and trim(v)
end

-- "a, b=c, d={e,f}" -> table
local function parse_options(str)
  local opts = { format = "auto", scale = 1, marking = true, waypoints = false,
                 targets = {}, size = {} }
  for _, p in ipairs(split_top(str)) do
    local k, v = keyval(p)
    if v then v = v:gsub("^{(.*)}$", "%1") end
    if k == "format" then opts.format = v
    elseif k == "notation" then
      if not NOTATIONS[v] then
        fail("notation=" .. tostring(v) .. ": use dcr-solutions, classic or coopis23")
      end
      opts.notation = v
    elseif k == "scale" then opts.scale = tonumber(v) or fail("scale=" .. tostring(v) .. " is not a number")
    elseif k == "waypoints" then opts.waypoints = truthy(v)
    elseif k == "marking" then opts.marking = truthy(v)
    elseif k == "export" then opts.export = v
    elseif k == "guards" or k == "delays" or k == "deadlines" then
      -- a mode for the whole graph, or a list of relations whose value
      -- is shown as text: guards={A4 response A6, A6 A7}
      local modes = (k == "guards") and { shield = 1, explicit = 1, both = 1, none = 1 }
                                     or { marker = 1, explicit = 1, none = 1 }
      if modes[v] then
        opts[k] = v
      else
        opts.targets[k] = parse_targets(k, v)
      end
    elseif k == "explicit" then
      -- all values as text
      opts.explicit_all = true
    elseif k == "width" or k == "height" or k == "max width" or k == "max height" then
      -- the size of the whole graph: passed on to the environment
      if not v or v == "" then fail(k .. "= needs a length") end
      opts.size[#opts.size + 1] = { k, v }
    else warn("unknown option `" .. k .. "' ignored") end
  end
  return opts
end

-- ------------------------------------------------------------------
--  Adjustments: \adjustactivity{id}{options}, \adjustrelation{relation}
--  {options} in a dcrgraphfile environment, given as a list of
--  {kind = "activity"|"relation", target = ..., opts = ...}. Parsed here;
--  applied in the layout step (moves) and the emitter (everything else).
-- ------------------------------------------------------------------
-- a length in cm: "1", "1cm", "5mm", "10pt", "0.5in"
local function length_cm(s, what)
  local n, unit = trim(s or ""):gsub("^{(.*)}$", "%1"):match("^([%-%+]?[%d%.]+)%s*(%a*)$")
  local factor = ({ [""] = 1, cm = 1, mm = 0.1, pt = 1 / 28.45274, ["in"] = 2.54,
                    bp = 2.54 / 72 })[unit or "?"]
  if not n or not tonumber(n) or not factor then
    fail(what .. ": `" .. tostring(s) .. "' is not a length")
  end
  return tonumber(n) * factor
end

local function parse_adjustments(raw)
  local adj = { activities = {}, relations = {} }
  for _, a in ipairs(raw or {}) do
    local where = "\\adjust" .. a.kind .. "{" .. a.target .. "}"
    if a.kind == "activity" then
      local e = { id = trim(a.target), dx = 0, dy = 0, extra = {}, text = a.opts }
      for _, p in ipairs(split_top(a.opts)) do
        local k, v = keyval(p)
        if k == "shift" then
          local x, y = (v or ""):gsub("^{(.*)}$", "%1"):match("^%(%s*(.-)%s*,%s*(.-)%s*%)$")
          if not x then fail(where .. ": shift=" .. tostring(v) .. " is not of the form {(x,y)}") end
          e.dx, e.dy = e.dx + length_cm(x, where), e.dy + length_cm(y, where)
        elseif k == "xshift" then e.dx = e.dx + length_cm(v, where)
        elseif k == "yshift" then e.dy = e.dy + length_cm(v, where)
        else e.extra[#e.extra + 1] = p end
      end
      adj.activities[#adj.activities + 1] = e
    elseif a.kind == "relation" then
      local t = parse_targets(where, a.target)
      if #t ~= 1 then fail(where .. ": name exactly one relation") end
      local e = { target = t[1], extra = {}, text = a.opts }
      for _, p in ipairs(split_top(a.opts)) do
        local k, v = keyval(p)
        if k == "from" or k == "to" then
          e[k] = (v or ""):gsub("^{(.*)}$", "%1")   -- an anchor: south, 30, ...
        else e.extra[#e.extra + 1] = p end
      end
      adj.relations[#adj.relations + 1] = e
    else
      fail("unknown adjustment `" .. tostring(a.kind) .. "'")
    end
  end
  return adj
end

-- ------------------------------------------------------------------
--  Entry points
-- ------------------------------------------------------------------
local function read_file(name)
  local f = io.open(name, "rb")
  if not f and kpse and kpse.find_file then
    local found = kpse.find_file(name)
    if found then f = io.open(found, "rb") end
  end
  if not f then fail("cannot open file `" .. name .. "'") end
  local text = f:read("*a")
  f:close()
  return text
end

-- file name + option string (+ adjustments, see above) -> model, options
function M.read(file, optstring, adjustments)
  M.warnings = {}
  local opts = parse_options(optstring)
  opts.adjust = parse_adjustments(adjustments)
  if not format_names[opts.format] then
    fail("unknown format `" .. tostring(opts.format)
      .. "' (the format is recognised from the file; format= is not needed)")
  end
  -- {} = no HTML void elements: pure XML (else <meta>...</meta>, used by
  -- the DCR portal, is rejected as unbalanced)
  local dom = require("luaxml-domobject").parse(read_file(file), {})
  local graph = front_ends[detect_format(dom)](dom)
  -- Classic and CoopIS2023 notation: pre-conditions become the two
  -- relations they are made of (condition + milestone); the milestone of a
  -- timed pre-condition carries no time (milestones are not timed in the
  -- literature). A logical include stays one relation (->±, with the guard
  -- of its include half)
  if literature_notation(opts.notation) then
    local rels = {}
    for _, r in ipairs(graph.relations) do
      if r.parts and r.kind == "precondition" then
        -- time and guard on the condition only (also if the file has the
        -- guard on the milestone half)
        for _, p in ipairs(r.parts) do
          if p.kind == "milestone" then p.delay, p.guard = nil, nil
          else p.guard = r.guard end
          rels[#rels + 1] = p
        end
      else
        rels[#rels + 1] = r
      end
    end
    graph.relations = rels
  end
  return graph, opts
end

-- file name + option string (+ adjustments) -> list of lines, options
function M.convert(file, optstring, adjustments)
  local graph, opts = M.read(file, optstring, adjustments)
  return emit(graph, opts, layout(graph, opts)), opts
end

-- ------------------------------------------------------------------
--  Descriptions for the tests: the content (what the graph says) and the
--  layout (where it is drawn), as sorted text lines, separately.
-- ------------------------------------------------------------------
local node_flags = { "executed", "pending", "excluded",
                     "data", "computation", "dmn", "global", "subgraph", "form" }

function M.describe_content(graph)
  local lines = {}
  for _, n in ipairs(graph.nodes) do
    local t = { n.kind, n.id, string.format("label=%q", n.label) }
    if #n.roles > 0 then t[#t + 1] = "roles=" .. table.concat(n.roles, "|") end
    if n.receivers and #n.receivers > 0 then
      t[#t + 1] = "receivers=" .. table.concat(n.receivers, "|")
    end
    for _, f in ipairs(node_flags) do if n[f] then t[#t + 1] = f end end
    if n.bg then t[#t + 1] = "bg=" .. n.bg end
    if n.stroke then t[#t + 1] = "stroke=" .. n.stroke end
    if n.text then t[#t + 1] = "text=" .. n.text end
    if #n.children > 0 then
      local kids = { table.unpack(n.children) }
      table.sort(kids)
      t[#t + 1] = "children=" .. table.concat(kids, ",")
    end
    lines[#lines + 1] = table.concat(t, " ")
  end
  for _, r in ipairs(graph.relations) do
    local t = { "relation", r.kind, r.from, "->", r.to }
    if r.delay then t[#t + 1] = "delay=" .. r.delay end
    if r.guard then t[#t + 1] = string.format("guard=%q", r.guard) end
    lines[#lines + 1] = table.concat(t, " ")
  end
  table.sort(lines)
  return lines
end

function M.describe_layout(graph, opts)
  local lay = layout(graph, opts)
  local lines = {}
  for _, n in ipairs(graph.nodes) do
    local g = lay.node[n.id]
    if n.kind == "activity" then
      lines[#lines + 1] = string.format("%s at=(%s,%s) size=%sx%s", n.id,
        fmt(g.x), fmt(g.y), fmt(g.w), fmt(g.h))
    else
      lines[#lines + 1] = string.format("%s area=(%s,%s)(%s,%s)", n.id,
        fmt(g.x1), fmt(g.y1), fmt(g.x2), fmt(g.y2))
    end
  end
  for i, r in ipairs(graph.relations) do
    if lay.via[i] then
      local p = {}
      for _, w in ipairs(lay.via[i]) do p[#p + 1] = "(" .. fmt(w[1]) .. "," .. fmt(w[2]) .. ")" end
      lines[#lines + 1] = string.format("%s %s -> %s via=%s", r.kind, r.from, r.to,
        table.concat(p, ""))
    end
  end
  for i, r in ipairs(graph.relations) do
    if lay.port[i] then
      local p, q = lay.port[i][1], lay.port[i][2]
      lines[#lines + 1] = string.format("port %s %s (%s,%s) -> %s (%s,%s)", r.kind,
        r.from, fmt(p[1]), fmt(p[2]), r.to, fmt(q[1]), fmt(q[2]))
    end
    if lay.selfpos[i] then
      lines[#lines + 1] = string.format("self %s %s at %s", r.kind, r.from, fmt(lay.selfpos[i]))
    end
    local a = lay.radj[i]
    if a then
      lines[#lines + 1] = string.format("adjust %s %s -> %s:%s%s%s", r.kind, r.from, r.to,
        a.from and (" from=" .. a.from) or "", a.to and (" to=" .. a.to) or "",
        #a.extra > 0 and (" " .. table.concat(a.extra, ", ")) or "")
    end
  end
  for id, extra in pairs(lay.nextra) do
    lines[#lines + 1] = "adjust " .. id .. ": " .. table.concat(extra, ", ")
  end
  for _, sz in ipairs(opts.size) do
    lines[#lines + 1] = "size " .. sz[1] .. "=" .. sz[2]
  end
  -- which values are written as text (options guards=, delays=,
  -- deadlines=, explicit; for the whole graph or single relations)
  local parts = M.explicit_parts(graph, opts)
  local all = opts.explicit_all
  -- as text: with explicit (both), and in classic notation by default
  -- (it has no shields or clocks), unless the mode is none.
  -- (This repeats the rules of \dcr@relation in the TeX part, for the
  -- tests only; change both together.)
  local classic = literature_notation(opts.notation)
  local function as_text(mode)
    if all or mode == "explicit" or mode == "both" then return true end
    return classic and mode ~= "none"
  end
  for i, r in ipairs(graph.relations) do
    local shown = {}
    for _, p in ipairs(parts[i] or {}) do shown[p] = true end
    if r.guard and as_text(opts.guards) then shown.guard = true end
    if r.delay and r.kind == "response" and as_text(opts.deadlines) then
      shown.deadline = true
    end
    if r.delay and r.kind ~= "response" and as_text(opts.delays) then
      shown.delay = true
    end
    for _, p in ipairs({ "guard", "delay", "deadline" }) do
      if shown[p] then
        lines[#lines + 1] = string.format("show %s %s %s -> %s", p, r.kind, r.from, r.to)
      end
    end
  end
  for _, w in ipairs(M.warnings) do lines[#lines + 1] = "warning: " .. w end
  table.sort(lines)
  return lines
end

local function export_header(file)
  return "% generated by dcrgraph.sty from " .. file
end

-- called by \includedcrgraph
-- the adjustments of the current dcrgraphfile environment
M.pending_adjust = {}
function M.begin_adjust() M.pending_adjust = {} end
function M.add_adjust(kind, target, opts)
  table.insert(M.pending_adjust, { kind = kind, target = target, opts = opts })
end

-- called by \includedcrgraph (and at the end of dcrgraphfile, with the
-- collected adjustments)
function M.include(optstring, file, adjustments)
  in_tex = true
  local ok, lines, opts = pcall(M.convert, file, optstring, adjustments)
  if not ok then
    tex.error(tostring(lines))
    return
  end
  tex.print(lines)
  if opts.export then
    -- written by TeX (\openout), not by Lua, so the file goes where TeX
    -- writes its output (-output-directory); that is where Overleaf
    -- looks for generated files. Text is passed as catcode 12 (-2), so
    -- \write copies it unchanged.
    local out = { export_header(file) }
    for _, l in ipairs(lines) do out[#out + 1] = l end
    tex.sprint("\\immediate\\openout\\csname dcr@export\\endcsname=\"")
    tex.sprint(-2, opts.export)
    tex.sprint("\"\\relax")
    for _, l in ipairs(out) do
      -- leading spaces as \space, since TeX merges spaces in the text
      local indent, text = l:match("^( *)(.*)$")
      tex.sprint("\\immediate\\write\\csname dcr@export\\endcsname{"
        .. string.rep("\\space", #indent))
      tex.sprint(-2, text)
      tex.sprint("}")
    end
    tex.sprint("\\immediate\\closeout\\csname dcr@export\\endcsname")
    M.pending_export = opts.export
    tex.sprint("\\directlua{dcrgraphs.check_export()}")
    -- and a copy in the log, which can always be reached (e.g. Overleaf:
    -- Logs and output files > Raw logs)
    texio.write_nl("log", "dcrgraph: exported to " .. opts.export .. " -- copy:")
    texio.write_nl("log", "----- begin dcrgraph export " .. opts.export .. " -----")
    for _, l in ipairs(out) do texio.write_nl("log", l) end
    texio.write_nl("log", "----- end dcrgraph export -----")
    texio.write_nl("log", "")
  end
end

-- after \closeout: report where the export went, or that it is missing
-- (as a package warning, which Overleaf shows in its log panel)
function M.check_export()
  local name = M.pending_export
  M.pending_export = nil
  if not name then return end
  local dir = status.output_directory
  local path = (dir and dir ~= "") and (dir .. "/" .. name) or name
  local cwd = lfs and lfs.currentdir() or "?"
  local f = io.open(path, "rb")
  if f then
    f:close()
    warn("export written to `" .. path .. "' (working directory `" .. cwd .. "')")
  else
    warn("export file `" .. name .. "' was NOT written (looked for `" .. path
      .. "' in `" .. cwd .. "', openout_any=" .. tostring(kpse.var_value("openout_any"))
      .. "). The code is in the .log, between the dcrgraph export markers")
  end
end

-- command line (see dcrgraph-cli.lua): args = {"--key[=value]", ..., file}
function M.main(args)
  local optlist, file = {}, nil
  for _, a in ipairs(args) do
    local o = a:match("^%-%-(.*)$")
    if o then optlist[#optlist + 1] = o else file = a end
  end
  if not file then
    io.stderr:write("usage: texlua dcrgraph-cli.lua [--waypoints] [--notation=dcr-solutions|classic|coopis23]\n"
      .. "         [--scale=N] [--marking=false] [--export=out.tex] file\n")
    os.exit(1)
  end
  local ok, lines, opts = pcall(M.convert, file, table.concat(optlist, ","))
  if not ok then io.stderr:write(tostring(lines), "\n"); os.exit(1) end
  if opts.export then
    local f = io.open(opts.export, "w")
    if not f then io.stderr:write("cannot write `" .. opts.export .. "'\n"); os.exit(1) end
    f:write(export_header(file), "\n", table.concat(lines, "\n"), "\n")
    f:close()
  end
  print(table.concat(lines, "\n"))
end

return M
